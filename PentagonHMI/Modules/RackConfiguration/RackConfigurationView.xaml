<UserControl x:Class="PentagonHMI.RackConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PentagonHMI"
             TextElement.FontSize="16" TextElement.FontWeight="Regular">

    <GroupBox x:Name="RackConfigurationGroupBox" Header="Rack Configuration"
              Style="{StaticResource TopHeaderGroupBoxStyle}">
        <ScrollViewer x:Name="RackConfigurationScrollViewer"
                      HorizontalAlignment="Left">
            <ItemsControl ItemsSource="{Binding RackListView}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Style="{StaticResource TopHeaderGroupBoxStyle}"
                                  Header="{Binding RackName}">
                            <VirtualizingStackPanel>
                                <ItemsControl ItemsSource="{Binding RackTextListView}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="300"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding RackTextName}"
                                                           Style="{StaticResource KeyTextBlockStyle}"/>

                                                <TextBox Grid.Column="1" Text="{Binding RackText}"
                                                         IsEnabled="{Binding RackTextEnable}"
                                                         VerticalContentAlignment="Center"/>

                                                <Button Grid.Column="2" x:Name="UpdateRackTextButton"
                                                        Style="{StaticResource ButtonStyle}"
                                                        Content="Update" Tag="{Binding}"
                                                        IsEnabled="{Binding RackTextEnable}"
                                                        Click="updateRackTextButton_Click"/>

                                                <Button Grid.Column="3" x:Name="ClearRackTextButton"
                                                        Style="{StaticResource ButtonStyle}"
                                                        Content="Clear" Tag="{Binding}"
                                                        IsEnabled="{Binding RackTextEnable}"
                                                        Click="clearRackTextButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding RackToggleListView}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding RackToggleName}"
                                                           Style="{StaticResource KeyTextBlockStyle}"/>

                                                <Button Grid.Column="1" x:Name="RackToggleOffButton"
                                                        Style="{StaticResource ButtonStyle}" Background="Red"
                                                        Content="Off" Tag="{Binding}"
                                                        IsEnabled="{Binding RackToggleStatus}"
                                                        Click="rackToggleOffButton_Click"/>

                                                <Button Grid.Column="2" x:Name="RackToggleOnButton"
                                                        Style="{StaticResource ButtonStyle}" Background="Green"
                                                        Content="On" Tag="{Binding}"
                                                        IsEnabled="{Binding RackToggleStatus, Converter={StaticResource InverseBooleanConverter}}"
                                                        Click="rackToggleOnButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </VirtualizingStackPanel>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </GroupBox>

</UserControl>