<UserControl x:Class="PentagonHMI.RecipeConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PentagonHMI"
             TextElement.FontSize="18" TextElement.FontWeight="Regular">

    <GroupBox Style="{StaticResource TopHeaderGroupBoxStyle}" Header="Recipe Configuration">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                      Header="Configuration" Margin="0 0 0 10" Padding="4">
                <ComboBox x:Name="RecipeConfigurationComboBox" DisplayMemberPath="RecipeName"
                          SelectionChanged="recipeConfigurationComboBox_SelectionChanged" />
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.Column="0" Header="Edit Settings">
                <Grid Margin="4" TextElement.FontSize="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" x:Name="SaveSettingsButton" Style="{StaticResource ButtonStyle}"
                            Content="Save Settings" Click="saveSettingsButton_Click" />

                    <TextBlock Grid.Row="1" FontWeight="Bold" Margin="0 10 0 0" Text="GPN List" />

                    <DataGrid Grid.Row="2" x:Name="EditMPNListDataGrid" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              CanUserResizeColumns="False" CanUserResizeRows="False" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding MPN}" Header="GPN" Width="250" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.Column="1" Header="Current Settings" Margin="10 0 0 0">
                <Grid Margin="4" TextElement.FontSize="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               FontWeight="Bold" Text="RAM Height" />

                    <CheckBox Grid.Row="1" Grid.Column="0" x:Name="CurrentRAMHeightTallCheckBox"
                              Content="Tall" FontSize="10" IsHitTestVisible="False">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>

                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="CurrentRAMHeightShortCheckBox"
                              Content="Short" FontSize="10" IsHitTestVisible="False">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               FontWeight="Bold" Margin="0 10 0 0" Text="Tray Definition" />

                    <TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Text="Rows" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CurrentTrayDefinitionRowsTextBlock" />

                    <TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Text="Columns" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CurrentTrayDefinitionColumnsTextBlock" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                               FontWeight="Bold" Margin="0 10 0 0" Text="GPN List" />

                    <DataGrid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" IsReadOnly="True"
                              x:Name="CurrentMPNListDataGrid" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding MPN}" Header="GPN" Width="250" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center"
                               FontWeight="Bold" Margin="10 0 0 0" Text="Tray Image" />
                    <Image Grid.Row="1" Grid.RowSpan="6" Grid.Column="2" Margin="10 0 0 0"
                           Source="{Binding ElementName=RecipeConfigurationComboBox, Path=SelectedItem.TrayImage}" />
                </Grid>
            </GroupBox>
        </Grid>
    </GroupBox>
</UserControl>