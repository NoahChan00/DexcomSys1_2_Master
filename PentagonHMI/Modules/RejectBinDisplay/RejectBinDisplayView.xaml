<UserControl x:Class="PentagonHMI.RejectBinDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PentagonHMI"
             TextElement.FontSize="18" TextElement.FontWeight="Regular">

    <GroupBox x:Name="RejectBinDisplayGroupBox" Header="Reject Bin"
              Style="{StaticResource TopHeaderGroupBoxStyle}">
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding RejectBinDisplayStatusListView}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Style="{StaticResource TopHeaderGroupBoxStyle}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{StaticResource KeyTextBlockStyle}"
                                           Text="{Binding RejectBinDisplayStatusName}"/>

                                <TextBox Grid.Column="1" IsReadOnly="True"
                                         Text="{Binding RejectBinDisplayStatus}"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </GroupBox>

</UserControl>