<Window x:Class="PentagonHMI.PopUpView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PentagonHMI"
        x:Name="PopUpWindow" MaxHeight="700" MaxWidth="800" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" TextElement.FontSize="16" TextElement.FontWeight="Regular"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" Topmost="True"
        WindowStartupLocation="CenterScreen" Loaded="popUpWindow_Loaded" Closing="popUpWindow_Closing">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="PopUpItemsControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <GroupBox Style="{StaticResource TopHeaderGroupBoxStyle}">
                        <GroupBox.Header>
                            <TextBlock FontSize="28" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" Padding="4 2"
                                       Text="{Binding PopUpMessage}" TextAlignment="Center"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Width="700" />
                        </GroupBox.Header>

                        <ItemsControl ItemsSource="{Binding PopUpActionListView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="PopUpActionButton" FontSize="20" Height="60"
                                            Style="{StaticResource ButtonStyle}"
                                            Content="{Binding PopUpActionName}" Tag="{Binding}"
                                            Click="popUpActionButton_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Window>