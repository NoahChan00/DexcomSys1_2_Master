<UserControl x:Class="PentagonHMI.IOView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TextElement.FontSize="18">

    <GroupBox Style="{StaticResource TopHeaderGroupBoxStyle}" Header="Machine Input/Output List">
        <Grid>
            <TabControl x:Name="IOTabControl" Margin="2 20 2 2" SelectionChanged="tabControl_SelectionChanged">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding IOTypeName}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <TabControl ItemsSource="{Binding IOIndexList}" TabStripPlacement="Left" SelectionChanged="tabControl_SelectionChanged">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IOIndexName}" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <TabControl ItemsSource="{Binding IOList}" TabStripPlacement="Bottom" SelectionChanged="tabControl_SelectionChanged">
                                        <TabControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IOName}" />
                                            </DataTemplate>
                                        </TabControl.ItemTemplate>
                                        <TabControl.ContentTemplate>
                                            <DataTemplate>
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                    <ItemsControl IsHitTestVisible="{Binding IOEnable}" ItemsSource="{Binding IOTagList}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Vertical" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox x:Name="IOCheckBox" Content="{Binding IOTagName}" Cursor="Hand"
                                                                        IsChecked="{Binding IOTagStatus}" IsHitTestVisible="{Binding IOTagEnable}" Margin="1"
                                                                        Tag="{Binding}" Click="iOCheckBox_Click">
                                                                    <CheckBox.Style>
                                                                        <Style TargetType="{x:Type CheckBox}">
                                                                            <Setter Property="FontSize" Value="8" />
                                                                            <Setter Property="OverridesDefaultStyle" Value="True" />
                                                                            <Setter Property="SnapsToDevicePixels" Value="True" />
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="{x:Type CheckBox}">
                                                                                        <Border BorderBrush="Gray" BorderThickness="0.5" CornerRadius="8"
                                                                                                Padding="2">
                                                                                            <BulletDecorator>
                                                                                                <BulletDecorator.Bullet>
                                                                                                    <Border x:Name="Border"
                                                                                                            Background="{StaticResource RedBrush}"
                                                                                                            BorderBrush="{StaticResource NormalBorderBrush}"
                                                                                                            BorderThickness="1" CornerRadius="10" Height="20"
                                                                                                            Width="20">
                                                                                                        <Grid x:Name="Grid">
                                                                                                            <Ellipse Height="18" Width="18">
                                                                                                                <Ellipse.Fill>
                                                                                                                    <RadialGradientBrush Center="0.5,0.5"
                                                                                                                            GradientOrigin="0.5,0.5"
                                                                                                                            RadiusX="0.5" RadiusY="0.5">
                                                                                                                        <GradientStop Color="White" Offset="0.1" />
                                                                                                                        <GradientStop Color="Green" Offset="0.8" />
                                                                                                                        <GradientStop Color="LightGreen"
                                                                                                                                Offset="1" />
                                                                                                                    </RadialGradientBrush>
                                                                                                                </Ellipse.Fill>
                                                                                                            </Ellipse>

                                                                                                            <TextBlock FontSize="6" FontWeight="Bold"
                                                                                                                    HorizontalAlignment="Center" Text="ON"
                                                                                                                    VerticalAlignment="Center" />
                                                                                                        </Grid>
                                                                                                    </Border>
                                                                                                </BulletDecorator.Bullet>

                                                                                                <ContentPresenter HorizontalAlignment="Left" Margin="4 0"
                                                                                                        RecognizesAccessKey="True" VerticalAlignment="Center" />
                                                                                            </BulletDecorator>
                                                                                        </Border>

                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsChecked" Value="{x:Null}">
                                                                                                <Setter TargetName="Border" Property="Background"
                                                                                                        Value="{StaticResource YellowBrushOver}" />
                                                                                                <Setter TargetName="Grid" Property="Visibility"
                                                                                                        Value="Collapsed" />
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsChecked" Value="False">
                                                                                                <Setter TargetName="Grid" Property="Visibility"
                                                                                                        Value="Collapsed" />
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                                <Setter TargetName="Border" Property="Background"
                                                                                                        Value="Transparent" />
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                                <Setter TargetName="Border" Property="Background"
                                                                                                        Value="{StaticResource DisabledBackgroundBrush}" />
                                                                                                <Setter TargetName="Border" Property="BorderBrush"
                                                                                                        Value="{StaticResource DisabledBorderBrush}" />
                                                                                                <Setter Property="Foreground"
                                                                                                        Value="{StaticResource DisabledForegroundBrush}" />
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="Border" Property="Background"
                                                                                                        Value="{StaticResource RedBrushOver}" />
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                                <Setter TargetName="Border" Property="Background"
                                                                                                        Value="{StaticResource PressedBrush}" />
                                                                                                <Setter TargetName="Border" Property="BorderBrush"
                                                                                                        Value="{StaticResource PressedBorderBrush}" />
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </CheckBox.Style>

                                                                    <CheckBox.LayoutTransform>
                                                                        <ScaleTransform ScaleX="2" ScaleY="2" />
                                                                    </CheckBox.LayoutTransform>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </DataTemplate>
                                        </TabControl.ContentTemplate>
                                    </TabControl>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <ToggleButton x:Name="EngineeringModeToggleButton" Cursor="Hand" FontWeight="Bold" Height="40" Margin="10 6" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Width="300" Click="engineeringModeToggleButton_Click">
                <ToggleButton.Style>
                    <Style TargetType="{x:Type ToggleButton}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter Property="Background" Value="Orange" />
                                <Setter Property="Content" Value="Engineering Mode" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Background" Value="Red" />
                                <Setter Property="Content" Value="Engineering Mode (OFF)" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="LimeGreen" />
                                <Setter Property="Content" Value="Engineering Mode (ON)" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Grid>
    </GroupBox>
</UserControl>