<UserControl x:Class="PentagonHMI.EngineeringView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TextElement.FontSize="16"
        TextElement.FontWeight="Regular">

    <GroupBox Style="{StaticResource TopHeaderGroupBoxStyle}" Header="Engineering">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="EngineeringItemsControl" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Style="{StaticResource TopHeaderGroupBoxStyle}" Header="{Binding EngineeringGroupName}">
                            <VirtualizingStackPanel>
                                <ItemsControl ItemsSource="{Binding EngineeringGroupTextListView}" VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="300" />
                                                    <ColumnDefinition Width="Auto" MinWidth="150" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding EngineeringTextName}" Style="{StaticResource KeyTextBlockStyle}" />

                                                <TextBox Grid.Column="1" Text="{Binding EngineeringTextValue}" VerticalContentAlignment="Center" />

                                                <Button Grid.Column="2" x:Name="SetEngineeringGroupTextButton" Style="{StaticResource ButtonStyle}"
                                                        Content="Set" Tag="{Binding}" Click="setEngineeringGroupTextButton_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding EngineeringGroupSelectionListView}" VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="300" />
                                                    <ColumnDefinition Width="Auto" MinWidth="150" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Style="{StaticResource KeyTextBlockStyle}"
                                                        Text="{Binding EngineeringGroupSelectionName}" />

                                                <ComboBox Grid.Column="1" ItemsSource="{Binding EngineeringGroupSelectionItemListView}"
                                                        SelectedIndex="{Binding EngineeringGroupSelectionSelectedIndex}" />

                                                <Button Grid.Column="2" x:Name="SetEngineeringGroupSelectionButton" Style="{StaticResource ButtonStyle}"
                                                        Content="Set" Tag="{Binding}" Click="setEngineeringGroupSelectionButton_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding EngineeringGroupToggleListView}" VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="300" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Style="{StaticResource KeyTextBlockStyle}"
                                                        Text="{Binding EngineeringGroupToggleName}" />

                                                <Button Grid.Column="1" x:Name="EngineeringGroupToggleOffButton" Style="{StaticResource ButtonStyle}"
                                                        Background="Red" Content="Off" Tag="{Binding}" IsEnabled="{Binding EngineeringGroupToggle}"
                                                        Click="engineeringGroupToggleOffButton_Click" />

                                                <Button Grid.Column="2" x:Name="EngineeringGroupToggleOnButton" Style="{StaticResource ButtonStyle}"
                                                        Background="Green" Content="On" Tag="{Binding}"
                                                        IsEnabled="{Binding EngineeringGroupToggle, Converter={StaticResource InverseBooleanConverter}}"
                                                        Click="engineeringGroupToggleOnButton_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding EngineeringGroupActionListView}" VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button x:Name="EngineeringGroupActionButton" Style="{StaticResource ButtonStyle}" Tag="{Binding}"
                                                    Content="{Binding EngineeringGroupActionName}" Click="engineeringGroupActionButton_Click" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </VirtualizingStackPanel>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </GroupBox>
</UserControl>