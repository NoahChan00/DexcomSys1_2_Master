<UserControl x:Class="PentagonHMI.ControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PentagonHMI"
             TextElement.FontSize="18" TextElement.FontWeight="Bold">
    <UserControl.Resources>
    </UserControl.Resources>
    <VirtualizingStackPanel x:Name="ControlPanelVirtualizingStackPanel">
        <ItemsControl ItemsSource="{Binding ControlPanelActionListView}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding ufg_clm}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button x:Name="ControlPanelActionButton" Content="{Binding ControlPanelActionName}"
                            Height="48" IsEnabled="{Binding ControlPanelActionEnable}" Margin="2"
                            Tag="{Binding}" Click="controlPanelActionButton_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ControlPanelActionStatus}" Value="False">
                                        <Setter Property="Background"
                                                Value="{Binding ControlPanelActionStatusOffColor}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ControlPanelActionStatus}" Value="True">
                                        <Setter Property="Background"
                                                Value="{Binding ControlPanelActionStatusOnColor}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding ControlPanelToggleListView}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton x:Name="ControlPanelToggleButton" Content="{Binding ControlPanelToggleName}"
                                  Height="48" IsChecked="{Binding ControlPanelToggleStatus}" Margin="2"
                                  IsEnabled="{Binding ControlPanelToggleEnable}" Tag="{Binding}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Click="controlPanelToggleButton_Click">
                        <ToggleButton.Style>
                            <Style TargetType="{x:Type ToggleButton}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Label Background="Red" Content="Engineering Mode (OFF)" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="18" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Label Background="LimeGreen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Stretch" Content="Engineering Mode (ON)" FontSize="18"
                                                               FontWeight="Bold"/>                                       
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding ControlPanelToggleStatus}" Value="False">
                                        <Setter Property="Background"
                                                Value="{Binding ControlPanelToggleStatusOffColor}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ControlPanelToggleStatus}" Value="True">
                                        <Setter Property="Background"
                                                Value="{Binding ControlPanelToggleStatusOnColor}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </VirtualizingStackPanel>
</UserControl>