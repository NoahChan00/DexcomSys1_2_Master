<UserControl x:Class="PentagonHMI.ChildControls.ucTrayMap" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="15 2" />
            <Setter Property="Background" Value="LightGray" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Default" />
        <Style TargetType="{x:Type ToggleButton}">

            <Style.Resources>
                <Color x:Key="Color.Additional.LightGrey">#989EA8</Color>
                <Color x:Key="Color.Additional.MediumGrey">#61656B</Color>
                <Color x:Key="Color.MedtronicBranding.MedtronicBlue">#004B87</Color>
                <Color x:Key="Color.MedtronicBranding.CobaltBlue">#0085CA</Color>

                <Style x:Key="ToggleButtonContentTextbox" TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
                <SolidColorBrush x:Key="ToggleButtonFalseBackground" Color="{StaticResource Color.Additional.LightGrey}" />
                <SolidColorBrush x:Key="ToggleButtonTrueBackground" Color="{StaticResource Color.MedtronicBranding.CobaltBlue}" />
                <SolidColorBrush x:Key="ToggleButtonFalseForeground" Color="{StaticResource Color.Additional.MediumGrey}" />
                <SolidColorBrush x:Key="ToggleButtonTrueForeground" Color="{StaticResource Color.MedtronicBranding.MedtronicBlue}" />
                <TextBlock x:Key="OffContent" Style="{StaticResource ToggleButtonContentTextbox}" Text="Off" />
                <Style x:Key="OnContentControl" TargetType="ContentControl">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <TextBlock FontFamily="Wingdings 2" FontSize="24" FontWeight="Bold" Foreground="White"
                                        Style="{StaticResource ToggleButtonContentTextbox}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style x:Key="OffContentControl" TargetType="ContentControl">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <TextBlock FontSize="24" Foreground="White" Style="{StaticResource ToggleButtonContentTextbox}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </Style.Resources>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid x:Name="MainRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ElementName=TopRow, Path=ActualHeight}" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="{Binding ElementName=TopRow, Path=ActualHeight}" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="TopRow" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="9" Grid.Column="2">
                                    <TextBox x:Name="tbx_onlineBtrytype" Padding="5 0" Width="250" IsEnabled="False" FontSize="20" />
                                    <ComboBox x:Name="cbx_offlineBtrytype" FontSize="20" Width="250" Visibility="Hidden" />
                                </Grid>

                                <Ellipse x:Name="BackgroundEllipse1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Width="{Binding ElementName=MainRow,
                                                 Path=ActualHeight}" Height="{Binding ElementName=MainRow,
                                                  Path=ActualHeight}" HorizontalAlignment="Left" Fill="{StaticResource ToggleButtonTrueBackground}" />
                                <Ellipse x:Name="BackgroundEllipse2" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Width="{Binding ElementName=MainRow,
                                                 Path=ActualHeight}" Height="{Binding ElementName=MainRow,
                                                  Path=ActualHeight}" HorizontalAlignment="Right" Fill="{StaticResource ToggleButtonFalseBackground}" />
                                <Border x:Name="BackgroundBorder" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                        Background="{StaticResource ToggleButtonTrueBackground}" />
                            </Grid>

                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="AnimationWidth" />
                                    <ColumnDefinition Width="{Binding ElementName=MainRow, Path=ActualHeight}" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AnimationSizeBorder" Grid.Column="0" />
                                <ContentControl Grid.Column="0" Style="{StaticResource OnContentControl}" />
                            </Grid>

                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ElementName=MainRow, Path=ActualHeight}" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <ContentControl Grid.Column="1" Style="{StaticResource OffContentControl}" />
                            </Grid>

                            <Grid Background="Transparent">
                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                    <Border Width="{Binding ElementName=AnimationSizeBorder, Path=ActualWidth}" />
                                    <Ellipse x:Name="ForegroundEllipse" Width="{Binding ElementName=MainRow, Path=ActualHeight}"
                                            Height="{Binding ElementName=MainRow, Path=ActualHeight}" HorizontalAlignment="Right"
                                            Fill="{StaticResource ToggleButtonTrueForeground}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource ToggleButtonFalseBackground}" />
                                <Setter TargetName="ForegroundEllipse" Property="Fill" Value="{StaticResource ToggleButtonFalseForeground}" />
                                <Setter TargetName="AnimationSizeBorder" Property="Width" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" x:Name="ScrollViewerSystem1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0,0,5,0" BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Right Tray" Grid.ColumnSpan="2" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="30,2,2,0" />
                        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <UniformGrid Name="ugrd_RightTray" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 45" FlowDirection="RightToLeft">
                                <UniformGrid.Background>
                                    <ImageBrush ImageSource="/HMI;component/Images/TrayMap/S1LeftRight.png" />
                                </UniformGrid.Background>
                                <UniformGrid.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Margin" Value="10" />
                                        <Setter Property="Height" Value="30" />
                                        <Setter Property="Width" Value="30" />
                                    </Style>
                                </UniformGrid.Resources>
                            </UniformGrid>
                        </Grid>

                        <Grid Grid.Column="2" Grid.Row="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                <!--<Button Click="Reinspect_Click" Tag="L" Content="Reinspect Tray" FontSize="15" Margin="5" Padding="10" />-->

                                <!--<Button Click="ChangeTray_Click" Tag="R" Content="Change Tray" FontSize="15" Margin="5" Padding="10" />-->

                                <!--<TextBlock Text="Purge Right Rack" FontSize="15" Margin="5" TextAlignment="Center" Style="{StaticResource Default}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontSize="15" Text="Off" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                    <ToggleButton Width="75" Height="20" DataContextChanged="Purge_Click" Tag="L" />
                                    <TextBlock FontSize="15" Text="On" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                </StackPanel>-->
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0,0,5,0" BorderThickness="2" Grid.Column="1"
                        Grid.RowSpan="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <Label Content="PCBA Slot Tracking Tray" Grid.ColumnSpan="2" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18"
                                Padding="30,2,2,0" />
                        <Grid Name="pcba_SlotTrayGrid" Grid.Row="1">
                            <UniformGrid Name="pcba_SlotTray" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20 100 0 0"
                                    FlowDirection="RightToLeft">
                                <UniformGrid.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Margin" Value="12.5" />
                                        <Setter Property="Height" Value="25" />
                                        <Setter Property="Width" Value="25" />
                                    </Style>
                                </UniformGrid.Resources>
                                <UniformGrid.Background >
                                    <ImageBrush ImageSource="/HMI;component/Images/TrayMap/S1PCBA.png" />
                                </UniformGrid.Background>
                            </UniformGrid>
                        </Grid>
                        <Grid Grid.Column="2" Grid.Row="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                <!--<Button Click="Reinspect_Click" Tag="pcba" Content="Reinspect Tray" FontSize="15" Margin="5" Padding="10" />-->

                                <Button Name="PCBASlotButton" Click="ChangeTray_Click" Tag="HMI_PCBA_ReqChangeTray" Content="Change Tray" FontSize="15"
                                        Margin="5" Padding="10" />

                                <!--<TextBlock Text="Purge Left Rack" FontSize="15" Margin="5" TextAlignment="Center" Style="{StaticResource Default}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontSize="15" Text="Off" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                    <ToggleButton Width="75" Height="20" DataContextChanged="Purge_Click" Tag="pcba" />
                                    <TextBlock FontSize="15" Text="On" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                </StackPanel>-->
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0,0,5,0" BorderThickness="2" Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Left Tray" Grid.ColumnSpan="2" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="30,2,2,0" />
                        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <UniformGrid Name="ugrd_LeftTray" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 45" FlowDirection="RightToLeft">
                                <UniformGrid.Background>
                                    <ImageBrush ImageSource="/HMI;component/Images/TrayMap/S1LeftRight.png" />
                                </UniformGrid.Background>
                                <UniformGrid.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Margin" Value="10" />
                                        <Setter Property="Height" Value="30" />
                                        <Setter Property="Width" Value="30" />
                                    </Style>
                                </UniformGrid.Resources>
                            </UniformGrid>
                        </Grid>
                        <Grid Grid.Column="2" Grid.Row="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                <!--<Button Click="Reinspect_Click" Tag="L" Content="Reinspect Tray" FontSize="15" Margin="5" Padding="10" />-->

                                <!--<Button Click="ChangeTray_Click" Tag="R" Content="Change Tray" FontSize="15" Margin="5" Padding="10" />-->

                                <!--<TextBlock Text="Purge Left Rack" FontSize="15" Margin="5" TextAlignment="Center" Style="{StaticResource Default}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontSize="15" Text="Off" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                    <ToggleButton Width="75" Height="20" DataContextChanged="Purge_Click" Tag="L" />
                                    <TextBlock FontSize="15" Text="On" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                </StackPanel>-->
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <!--<Border CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0,0,5,0" BorderThickness="2" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Battery Slot Tracking Tray" Grid.ColumnSpan="2" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18"
                                Padding="30,2,2,0" />
                        <Grid Name="bat_SlotTrayGrid" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <UniformGrid Name="bat_SlotTray" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" FlowDirection="RightToLeft">
                                <UniformGrid.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Margin" Value="10" />
                                        <Setter Property="Height" Value="30" />
                                        <Setter Property="Width" Value="30" />
                                    </Style>
                                </UniformGrid.Resources>
                            </UniformGrid>
                        </Grid>

                        <Grid Grid.Column="2" Grid.Row="2">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                -->
                <!--<Button Click="Reinspect_Click" Tag="battery" Content="Reinspect Tray" FontSize="15" Margin="5" Padding="10" />-->
                <!--

                                <Button Name="BatterySlotButton" Click="ChangeTray_Click" Tag="HMI_Battery_ReqChangeTray" Content="Change Tray" FontSize="15"
                                        Margin="5" Padding="10" />

                                -->
                <!--<TextBlock Text="Purge Right Rack" FontSize="15" Margin="5" TextAlignment="Center" Style="{StaticResource Default}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontSize="15" Text="Off" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                    <ToggleButton Width="75" Height="20" DataContextChanged="Purge_Click" Tag="battery" />
                                    <TextBlock FontSize="15" Text="On" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                </StackPanel>-->
                <!--
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>-->
            </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="ScrollViewerSystem2" Grid.Column="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0,0,5,0" BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Input Left Slot" Grid.ColumnSpan="2" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18"
                                Padding="30,2,2,0" />
                        <Grid Name="input_LeftSlotGrid" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <UniformGrid Name="input_LeftSlot" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 45" FlowDirection="RightToLeft">
                                <UniformGrid.Background>
                                    <ImageBrush ImageSource="/HMI;component/Images/TrayMap/S2InputLeftRight.png" />
                                </UniformGrid.Background>

                                <UniformGrid.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Margin" Value="15" />
                                        <Setter Property="Height" Value="30" />
                                        <Setter Property="Width" Value="30" />
                                    </Style>
                                </UniformGrid.Resources>
                            </UniformGrid>
                        </Grid>
                        <Grid Grid.Column="2" Grid.Row="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                <!--<Button Click="Reinspect_Click" Tag="L" Content="Reinspect Tray" FontSize="15" Margin="5" Padding="10" />-->
                                <Button Name="InputLeftSlotButton" Click="ChangeTray_Click" Tag="HMI_LShuttle_ReqChangeTray" Content="Change Tray" FontSize="15"
                                        Margin="5" Padding="10" />
                                <!--<TextBlock Text="Purge Left Rack" FontSize="15" Margin="5" TextAlignment="Center" Style="{StaticResource Default}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontSize="15" Text="Off" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                        <ToggleButton Width="75" Height="20" DataContextChanged="Purge_Click" Tag="L" />
                                        <TextBlock FontSize="15" Text="On" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                    </StackPanel>-->
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0,0,5,0" BorderThickness="2" Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Input Right Slot" Grid.ColumnSpan="2" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18"
                                Padding="30,2,2,0" />
                        <Grid x:Name="input_RightSlotGrid" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <UniformGrid Name="input_RightSlot" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft"
                                    Margin="0 45">
                                <UniformGrid.Background>
                                    <ImageBrush ImageSource="/HMI;component/Images/TrayMap/S2InputLeftRight.png" />
                                </UniformGrid.Background>

                                <UniformGrid.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Margin" Value="15" />
                                        <Setter Property="Height" Value="30" />
                                        <Setter Property="Width" Value="30" />
                                    </Style>
                                </UniformGrid.Resources>
                            </UniformGrid>
                        </Grid>

                        <Grid Grid.Column="2" Grid.Row="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                <!--<Button Click="Reinspect_Click" Tag="L" Content="Reinspect Tray" FontSize="15" Margin="5" Padding="10" />-->

                                <Button Name="InputRightSlotButton" Click="ChangeTray_Click" Tag="HMI_RShuttle_ReqChangeTray" Content="Change Tray"
                                        FontSize="15" Margin="5" Padding="10" />

                                <!--<TextBlock Text="Purge Right Rack" FontSize="15" Margin="5" TextAlignment="Center" Style="{StaticResource Default}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontSize="15" Text="Off" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                        <ToggleButton Width="75" Height="20" DataContextChanged="Purge_Click" Tag="L" />
                                        <TextBlock FontSize="15" Text="On" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                    </StackPanel>-->
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0,0,5,0" BorderThickness="2" Grid.Column="1"
                        Grid.RowSpan="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Output Slot Tracking" Grid.ColumnSpan="2" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18"
                                Padding="30,2,2,0" />
                        <Grid Name="output_Slot_Grid" Grid.Row="1">
                            <UniformGrid Name="output_Slot" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft" Margin="0 25">
                                <UniformGrid.Background>
                                    <ImageBrush ImageSource="/HMI;component/Images/TrayMap/S2Output.jpg" />
                                </UniformGrid.Background>
                                <UniformGrid.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Margin" Value="15" />
                                        <Setter Property="Height" Value="30" />
                                        <Setter Property="Width" Value="30" />
                                    </Style>
                                </UniformGrid.Resources>
                            </UniformGrid>
                        </Grid>
                        <Grid Grid.Column="2" Grid.Row="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                <!--<Button Click="Reinspect_Click" Tag="pcba" Content="Reinspect Tray" FontSize="15" Margin="5" Padding="10" />-->

                                <Button Name="OutputSlotButton" Click="ChangeTray_Click" Tag="HMI_Unload_ReqChangeTray" Content="Change Tray" FontSize="15"
                                        Margin="5" Padding="10" />

                                <!--<TextBlock Text="Purge Left Rack" FontSize="15" Margin="5" TextAlignment="Center" Style="{StaticResource Default}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontSize="15" Text="Off" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                        <ToggleButton Width="75" Height="20" DataContextChanged="Purge_Click" Tag="pcba" />
                                        <TextBlock FontSize="15" Text="On" VerticalAlignment="Center" Padding="7 5" Style="{StaticResource Default}" />
                                    </StackPanel>-->
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Column="1" CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0,0,5,0" BorderThickness="2">
            <StackPanel Name="Legends">
                <Label Content="Legends" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="30,2,2,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>