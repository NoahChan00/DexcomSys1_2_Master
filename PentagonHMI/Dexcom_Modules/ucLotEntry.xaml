<UserControl x:Class="PentagonHMI.ChildControls.ucLotEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid x:Name="grd_Main">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0,0,5,0" BorderThickness="2">
                <StackPanel>
                    <Label Content="Lot Mode" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="30,2,2,0" />
                    <Viewbox Margin="5">
                        <UniformGrid Columns="1">
                            <RadioButton Checked="LotMode_Selected" IsChecked="True" Content="Commercial" Margin="2 5 5 0" VerticalContentAlignment="Bottom" Padding="10 0"/>
                            <RadioButton Checked="LotMode_Selected" Content="Non-Commercial" Margin="2 5 5 0" Padding="10 0" VerticalContentAlignment="Bottom"/>
                        </UniformGrid>
                    </Viewbox>
                </StackPanel>
            </Border>

            <Border CornerRadius=" 14,14,14,14" Grid.Column="1" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0,0,5,0" BorderThickness="2">
                <StackPanel>
                    <Label Content="Create Lot" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="30,2,2,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="5" FontSize="20" Text="Lot ID"/>
                        <TextBox x:Name="tbx_LotID" Padding="5 0" Grid.Row="1" Grid.Column="2" Width="250" FontSize="20"/>
                        <Button Click="NewLot_Click" Grid.Row="1" Grid.Column="3" Content="New Lot" Margin="2 0"/>
                        <Button x:Name="btn_ServerTest" Click="Server_Toggle" Grid.Row="1" Grid.Column="4" Content="Demo Server On/Off" Margin="2 0"/>

                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="5" FontSize="20" Text="Lot Size"/>
                        <TextBox x:Name="tbx_LotSize" Padding="5 0" PreviewTextInput="OnlyInt" Grid.Row="3" Grid.Column="2" Width="250" FontSize="20"/>

                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="5" FontSize="20" Text="Operator ID"/>
                        <TextBox x:Name="tbx_OprID" Grid.Row="5" Padding="5 0" Grid.Column="2" Width="250" MaxLength="20" FontSize="20"/>

                        <TextBlock Grid.Row="7" Grid.Column="1" Margin="5" FontSize="20" Text="DUT ID"/>
                        <Grid Grid.Row="7" Grid.Column="2">
                            <TextBox x:Name="tbx_onlineDUT" Padding="5 0"  Width="250" IsEnabled="False" FontSize="20"/>
                            <ComboBox x:Name="cbx_offlineDUT" FontSize="20" Width="250" Visibility="Hidden"/>
                        </Grid>

                        <TextBlock Grid.Row="9" Grid.Column="1" Margin="5" FontSize="20" Text="Battery Type"/>
                        <Grid Grid.Row="9" Grid.Column="2">
                            <TextBox x:Name="tbx_onlineBtrytype" Padding="5 0"  Width="250" IsEnabled="False" FontSize="20"/>
                            <ComboBox x:Name="cbx_offlineBtrytype" FontSize="20" Width="250" Visibility="Hidden"/>
                        </Grid>


                        <TextBlock Grid.Row="11" Grid.Column="1" Margin="5" FontSize="20" Text="Firmware Version"/>
                        <Grid Grid.Row="11" Grid.Column="2">
                            <TextBox x:Name="tbx_onlineFirmwareVersion" Padding="5 0"  Width="250" IsEnabled="False" FontSize="20"/>
                            <ComboBox x:Name="cbx_offlineFirmwareVersion" Padding="5 0" FontSize="20" Width="250" Visibility="Hidden"/>
                        </Grid>

                        <TextBlock Grid.Row="13" Grid.Column="1" Margin="5" FontSize="20" Text="Days to Expire"/>
                        <TextBox x:Name="tbx_day2Exp" Grid.Row="13" PreviewTextInput="OnlyInt" Padding="5 0" Grid.Column="2" Width="250" IsEnabled="False" FontSize="20"/>

                        <TextBlock Grid.Row="15" Grid.Column="1" Margin="5" FontSize="20" Text="Manufacture Date"/>
                        <TextBox x:Name="tbx_mdate" Grid.Row="15" Padding="5 0" Grid.Column="2" Width="250" IsEnabled="False" FontSize="20"/>

                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
