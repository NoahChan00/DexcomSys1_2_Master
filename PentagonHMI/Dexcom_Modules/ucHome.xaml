<UserControl x:Class="PentagonHMI.ChildControls.ucHome" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" mc:Ignorable="d"
        d:DesignHeight="643" d:DesignWidth="1776">

    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" MinWidth="400" CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0 1 1 1" BorderThickness="2">
                <StackPanel>
                    <Label Content="Lot Control" Grid.ColumnSpan="1" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="15 2" />
                    <UniformGrid Grid.Row="1" Columns="2">
                        <StackPanel>
                            <Button Click="Purge_Click" FontSize="20" Content="Purge Lot" Margin="10" Padding="10" />
                        </StackPanel>
                        <StackPanel>
                            <Button Click="End_Click" FontSize="20" Content="End Lot" Margin="10" Padding="10" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" MinWidth="400" CornerRadius=" 14,14,0,0" BorderBrush="{DynamicResource BlueLineBrush}" Margin="1" BorderThickness="2">
                <StackPanel>
                    <Label Content="Prompt Box" Grid.ColumnSpan="2" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="15 2" />
                    <ToggleButton x:Name="PromptToggleButton" Content="{Binding PromptToggleName}" Height="48" IsChecked="{Binding PromptToggleStatus}"
                            IsEnabled="{Binding PromptToggleEnable}" Tag="{Binding}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Click="promptToggleButton_Click">
                        <ToggleButton.Style>
                            <Style TargetType="{x:Type ToggleButton}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Label Background="Red" Content="End Lot" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="18" FontWeight="Bold" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Label Background="LimeGreen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center" VerticalAlignment="Stretch" Content="Continue" FontSize="18"
                                                            FontWeight="Bold" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding PromptToggleStatus}" Value="False">
                                        <Setter Property="Background" Value="{Binding PromptToggleStatusOffColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PromptToggleStatus}" Value="True">
                                        <Setter Property="Background" Value="{Binding PromptToggleStatusOnColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <Grid Grid.ColumnSpan="2" Grid.Row="2" Grid.RowSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="1" BorderThickness="2">
                    <StackPanel>
                        <Label Content="Quality" Grid.ColumnSpan="2" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="15 2" />
                        <lvc:PieChart Name="Pie_Quality" Height="380" LegendLocation="Bottom" Hoverable="False" DataTooltip="{x:Null}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="3" Grid.ColumnSpan="1" Grid.RowSpan="4" CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}"
                    Margin="1 0  0 0" BorderThickness="2">
                <StackPanel>
                    <Label Content="Station Status" Grid.ColumnSpan="2" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="15 2" />
                    <Grid x:Name="grd_KeyenceVision">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1000" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Legend -->
                            <Canvas>
                                <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0 45" Canvas.Left="50" Canvas.Top="30">
                                    <Image x:Name="TurnStepImage" />

                                    <Canvas Visibility="Visible">
                                        <StackPanel Canvas.Top="-55" Canvas.Left="-400">
                                            <TextBlock Text="Station" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="1" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <Button Height="30" Width="30" Background="Transparent" BorderBrush="Black" x:Name="Station1DutStatus" />
                                        </StackPanel>

                                        <StackPanel Canvas.Top="4" Canvas.Left="-153">
                                            <TextBlock Text="Station" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="2" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <Button Width="30" Height="30" Background="Transparent" BorderBrush="Black" x:Name="Station2DutStatus" />
                                        </StackPanel>

                                        <StackPanel Canvas.Top="197" Canvas.Left="0">
                                            <TextBlock Text="Station" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="3" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <Button Width="30" Height="30" Background="Transparent" BorderBrush="Black" x:Name="Station3DutStatus" />
                                        </StackPanel>

                                        <StackPanel Canvas.Top="330" Canvas.Left="-83">
                                            <TextBlock Text="Station" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="4" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <Button Height="30" Width="30" Background="Transparent" BorderBrush="Black" x:Name="Station4DutStatus" />
                                        </StackPanel>

                                        <StackPanel Canvas.Top="460" Canvas.Left="-400">
                                            <TextBlock Text="Station" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="5" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <Button Height="30" Width="30" Background="Transparent" BorderBrush="Black" x:Name="Station5DutStatus" />
                                        </StackPanel>

                                        <StackPanel Canvas.Top="400" Canvas.Left="-690">
                                            <TextBlock Text="Station" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="6" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <Button Height="30" Width="30" Background="Transparent" BorderBrush="Black" x:Name="Station6DutStatus" />
                                        </StackPanel>

                                        <StackPanel Canvas.Top="200" Canvas.Left="-840">
                                            <TextBlock Text="Station" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="7" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <Button Height="30" Width="30" Background="Transparent" BorderBrush="Black" x:Name="Station7DutStatus" />
                                        </StackPanel>

                                        <StackPanel Canvas.Top="4" Canvas.Left="-700">
                                            <TextBlock Text="Station" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="8" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
                                            <Button Height="30" Width="30" Background="Transparent" BorderBrush="Black" x:Name="Station8DutStatus" />
                                        </StackPanel>
                                    </Canvas>
                                </WrapPanel>
                                <GroupBox Header="Legend" IsHitTestVisible="True" HorizontalAlignment="Left" Width="180" Canvas.Left="812" Canvas.Top="510">
                                    <UniformGrid Columns="1" VerticalAlignment="Top">
                                        <Button Background="Gray" Content="No Unit" FontSize="10" FontWeight="Bold" BorderBrush="Black" />
                                        <Button Background="Blue" Content="Not Tested" FontSize="10" FontWeight="Bold" BorderBrush="Black" />
                                        <Button Background="Green" Content="Pass" FontSize="10" FontWeight="Bold" BorderBrush="Black" />
                                        <Button Background="Red" Content="Fail" FontSize="10" FontWeight="Bold" BorderBrush="Black" />
                                    </UniformGrid>
                                </GroupBox>

                            </Canvas>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid x:Name="GridForDUT" Grid.Column="4" Grid.ColumnSpan="1" Grid.RowSpan="4" Margin="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>