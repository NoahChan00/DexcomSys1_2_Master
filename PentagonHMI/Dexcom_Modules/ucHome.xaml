             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">

    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" MinWidth="400" CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0 1 1 1" BorderThickness="2">
                <StackPanel>
                    <Label Content="Lot Control" Grid.ColumnSpan="1" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="15 2" />
                    <UniformGrid Grid.Row="1" Columns="2">
                        <StackPanel>
                            <Button Click="Purge_Click" FontSize="20" Content="Purge Lot" Margin="10" Padding="10"/>
                        </StackPanel>
                        <StackPanel>
                            <Button Click="End_Click" FontSize="20" Content="End Lot" Margin="10" Padding="10"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" MinWidth="400" CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}" Margin="0 1 1 1" BorderThickness="2">
                <StackPanel>
                    <Label Content="Prompt Box" Grid.ColumnSpan="2" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="15 2" />
                    <StackPanel>
                        <ToggleButton x:Name="PromptToggleButton" Content="{Binding PromptToggleName}"
                                  Height="48" IsChecked="{Binding PromptToggleStatus}" Margin="10"
                                  IsEnabled="{Binding PromptToggleEnable}" Tag="{Binding}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Click="promptToggleButton_Click">
                            <ToggleButton.Style>
                                <Style TargetType="{x:Type ToggleButton}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Label Background="Red" Content="End Lot" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="18" FontWeight="Bold"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <Label Background="LimeGreen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Stretch" Content="Continue" FontSize="18"
                                                               FontWeight="Bold"/>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding PromptToggleStatus}" Value="False">
                                            <Setter Property="Background"
                                                Value="{Binding PromptToggleStatusOffColor}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PromptToggleStatus}" Value="True">
                                            <Setter Property="Background"
                                                Value="{Binding PromptToggleStatusOnColor}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Border>

