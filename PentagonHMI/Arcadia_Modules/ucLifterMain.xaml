<UserControl x:Class="PentagonHMI.Arcadia_Modules.ucLifterMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PentagonHMI.Arcadia_Modules"
             mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="Current Rack Infomation" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="30,2,2,0" />
                    <GroupBox Margin="10" Header="Current Rack In Lifter" FontSize="20" Grid.Row="1">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBox Name="tbx_CurrentRackInLifter" IsHitTestVisible="False" FontWeight="Bold" IsReadOnly="True" Text="NA" VerticalAlignment="Top" Margin="5" Padding="10 5" Width="300" TextWrapping="Wrap" />
                                <GroupBox Header="Rack Conveyor" Margin="5">
                                    <StackPanel Margin="5" VerticalAlignment="Top">
                                        <Button Content="Start" Click="RC_Click" FontSize="40" Margin="5" />
                                        <Button Content="Stop" Click="RC_Click" FontSize="40" Margin="5" />
                                        <Button Content="Reset" Click="RC_Click" FontSize="40" Margin="5" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                            <Grid>
                                <Border BorderThickness="2" Margin="5" BorderBrush="Gray">
                                    <Image Name="Img_CurrentRackInLifter" Width="500" Height="350" />
                                </Border>
                                <Border Name="brd_BiosMsg" BorderBrush="Red" BorderThickness="1">
                                    <Grid Background="Yellow">
                                        <StackPanel>
                                            <TextBlock Margin="5" Width="480" Text="Warning:" />
                                            <TextBlock Margin="5 0 5 5" Width="480" TextWrapping="Wrap">
                                            <Run>Please ensure</Run>
                                            <Run FontWeight="Bold">only 4</Run>
                                            <Run>BIOS/BMC trays are loaded (</Run>
                                            <Run FontWeight="Bold" Foreground="Blue">3</Run>
                                            <Run Foreground="Blue">trays with units</Run>
                                            <Run>and</Run>
                                            <Run FontWeight="Bold">1</Run>
                                            <Run>empty top cover).</Run>
                                            </TextBlock>
                                            <TextBlock Margin="5 0 5 5" Width="480" TextWrapping="Wrap">
                                            <Run>Ensure that the trays are loaded at the</Run>
                                            <Run Foreground="Blue" FontWeight="Bold">2</Run>
                                            <Run Foreground="Blue">tray slots away from you</Run>
                                            <Run>, not the 2 slots nearest to you.</Run>
                                            </TextBlock>
                                            <StackPanel Margin="-20 15 0 0"  HorizontalAlignment="Center" Orientation="Horizontal">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel>
                                                            <Rectangle Fill="Black" Width="150" Height="20" Margin="2 6 2 2" />
                                                            <Rectangle Fill="Black" Width="150" Height="20" Margin="2" />
                                                            <Rectangle Fill="Black" Width="150" Height="20" Margin="2" />
                                                            <Rectangle Fill="Black" Width="150" Height="20" Margin="2" />
                                                        </StackPanel>
                                                        <StackPanel Margin="2 0">
                                                            <Rectangle Width="10" Height="3" Fill="Black" Margin="0 12 0 0" />
                                                            <Border BorderBrush="Blue" BorderThickness="0 2 2 2" Margin="0 17 0 0">
                                                                <Rectangle  Height="60" Width="10" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="Empty Tray" />
                                                            <TextBlock Foreground="Blue" Text="Loaded Trays" Margin="0 20 0 0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Margin="15 0 0 0">
                                                    <Grid>
                                                        <Rectangle Height="140" Width="120" Fill="Black" />
                                                        <UniformGrid Columns="2">
                                                            <Label Width="40" Height="50" FontSize="14" VerticalContentAlignment="Center" Content="BMC" Background="Blue" Foreground="White" />
                                                            <Label Width="40" Height="50" FontSize="14" VerticalContentAlignment="Center" Content="BIOS" Background="Blue" Foreground="White" />
                                                            <Rectangle Width="40" Height="50" Fill="Yellow" />
                                                            <Rectangle Width="40" Height="50" Fill="Yellow" />
                                                        </UniformGrid>
                                                    </Grid>
                                                    <Grid>
                                                        <StackPanel Margin="23 -28 0 0" HorizontalAlignment="Left" Orientation="Horizontal">
                                                            <Rectangle RadiusX="10" RadiusY="10" Height="50" Width="15" Fill="LightGray">
                                                                <Rectangle.LayoutTransform>
                                                                    <RotateTransform Angle="10" />
                                                                </Rectangle.LayoutTransform>
                                                            </Rectangle>
                                                            <Rectangle Width="20" />
                                                            <Rectangle RadiusX="10" RadiusY="10" Height="50" Width="15" Fill="LightGray">
                                                                <Rectangle.LayoutTransform>
                                                                    <RotateTransform Angle="-30" />
                                                                </Rectangle.LayoutTransform>
                                                            </Rectangle>
                                                        </StackPanel>
                                                        <Rectangle RadiusX="10" RadiusY="10" Width="80" Height="20" Fill="Gray" />
                                                        <Ellipse Width="40" Height="40" Fill="DarkGray" />
                                                    </Grid>
                                                    <StackPanel Margin="43 -65 0 0" Orientation="Horizontal">
                                                        <Ellipse Margin="0 10 0 0" Width="8" Height="8" Fill="Black" />
                                                        <Ellipse Margin="5 -2 0 0" Width="8" Height="8" Fill="Black" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Click="btn_BiosMsgNoted_Click" Width="120" Height="40" Content="Noted" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="15" />
                                    </Grid>
                                </Border>
                                <Border Name="brd_ShowBiosMsg" Visibility="Hidden" BorderBrush="Red" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Background="Yellow">
                                        <TextBlock Margin="5" Text="Warning:" />
                                        <Button Click="btn_ShowMsg_Click" Margin="5" Width="120" Height="30" Content="Show Message" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Left" />                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Margin="10" Header="Current Rack ID" FontSize="20" Grid.Row="2">
                        <UniformGrid Columns="2">
                            <TextBox Name="tbx_CurrentRackID" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" HorizontalAlignment="Stretch" Text="NA" Margin="5" Padding="10 5" TextWrapping="Wrap" />
                            <Button Name="btn_UpdateRFIDtag" Click="UpdateRFIDtag_Click" Height="50" Margin="5" Content="Upadte RFID Tag" />
                        </UniformGrid>
                    </GroupBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.ColumnSpan="2" Content="Current Slot Status" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="30,2,2,0" />

                    <GroupBox Grid.Row="1" Margin="10" Header="Rack Status" FontSize="20">
                        <Grid>
                            <Border BorderThickness="1" VerticalAlignment="Top" BorderBrush="Black" Margin="30">
                                <StackPanel Width="300" VerticalAlignment="Top" Background="Silver">
                                    <ItemsControl Margin="20 5" Name="itmctrl_RackLayout">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Label Content="{Binding RackIndex}" FontSize="20" HorizontalContentAlignment="Center" Background="{Binding Status}" Margin="10 5" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <StackPanel Grid.Column="1" Grid.Row="1">
                        <GroupBox Margin="10" Header="Current Slot Index" FontSize="20">
                            <StackPanel>
                                <Grid>
                                    <TextBox Name="tbx_CurrentRackIndexNumber" IsHitTestVisible="False" MinHeight="100" VerticalContentAlignment="Center" FontSize="60" HorizontalContentAlignment="Center" FontWeight="Bold" Foreground="Blue" IsReadOnly="True" Text="NA" VerticalAlignment="Top" Margin="5" Padding="10 5" HorizontalAlignment="Stretch" TextWrapping="Wrap" />
                                    <ComboBox Name="cbx_CurrentSlotIndex"  VerticalContentAlignment="Center" MinHeight="100" FontSize="60" HorizontalContentAlignment="Center" FontWeight="Bold" Foreground="Blue" IsReadOnly="True" Text="NA" VerticalAlignment="Top" Margin="5" Padding="10 5" HorizontalAlignment="Stretch" />
                                </Grid>
                                <Button Name="btn_CurrenSlotIndex" Click="Rack_Index_Update_Click" Content="Edit" Padding="0 5" Margin="5" />
                            </StackPanel>
                        </GroupBox>
                        <UniformGrid Columns="1">
                            <Label Name="btn_SkipSlot" MouseLeftButtonDown="CurrentSlotStatus_Click" Tag="SkipSlot" Background="Silver"  FontSize="30" Padding="10" Margin="20 5" Content="Skip Slot"
                                   VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="Black" BorderThickness="1" />
                            <Label Name="btn_SkipRemaining" MouseLeftButtonDown="CurrentSlotStatus_Click" Tag="SkipRSlot" Background="Silver" FontSize="30" Padding="10 25" Margin="20 5" Content="Skip Remaining Slot"
                                   VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="Black" BorderThickness="1" />
                            <Label Name="btn_SkipRack" MouseLeftButtonDown="CurrentSlotStatus_Click" Tag="SkipRack" Background="Silver" FontSize="30" Padding="10" Margin="20 5" Content="Skip Rack"
                                   VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="Black" BorderThickness="1" />
                            <!--<Button Name="btn_Loaded" Click="CurrentSlotStatus_Click" Tag="Load" FontSize="30" Padding="10 25" Margin="20 5" Content="Slot Loaded" />
                            <Button Name="btn_Disabled" Click="CurrentSlotStatus_Click" Tag="Disabled" FontSize="30" Padding="10" Margin="20 5" Content="Slot Disabled" />
                            <Button Click="CurrentSlotStatus_Click" Tag="Skip" FontSize="30" Padding="10" Margin="20 5" Content="Skip Rack" />-->
                        </UniformGrid>
                        <TextBlock Margin="20 0" Text="*Skip Remaining Slot will not affect the status of any slot;" />
                        <TextBlock Margin="20 0" Text="*Skip Rack will treat the whole Rack as an Empty Rack;" />
                    </StackPanel>
                </Grid>
            </Border>
            <!--<TextBlock Name="msg" Background="White" VerticalAlignment="Top" />-->
        </Grid>
    </ScrollViewer>
</UserControl>