<Application x:Class="PentagonHMI.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:liveCharts="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" xmlns:converter="clr-namespace:PentagonHMI.Converters" StartupUri="Main.xaml"
        Startup="Application_Startup" Exit="Application_Exit" DispatcherUnhandledException="Application_DispatcherUnhandledException">
    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\TopPanel.xaml" />
                <ResourceDictionary Source="Resources\MainPanel.xaml" />
                <ResourceDictionary Source="Resources\Button.xaml" />
                <ResourceDictionary Source="Resources\RoundedButton.xaml" />
                <ResourceDictionary Source="Resources\GlassButton.xaml" />
                <ResourceDictionary Source="Resources\Checkbox.xaml" />
                <ResourceDictionary Source="Resources\Checkbox2.xaml" />
                <!--<ResourceDictionary Source="Resources\MenuButton.xaml" />-->
                <ResourceDictionary Source="Resources\TreeView.xaml" />
                <ResourceDictionary Source="Resources\ucHomeResource.xaml" />
                <ResourceDictionary Source="Resources\zh-CN.xaml" />
                <ResourceDictionary Source="Resources\en-US.xaml" />

                <ResourceDictionary Source="/Themes/Button.xaml" />
                <ResourceDictionary Source="/Themes/ButtonBase.xaml" />
                <ResourceDictionary Source="/Themes/CartesianChart.xaml" />
                <ResourceDictionary Source="/Themes/CheckBox.xaml" />
                <ResourceDictionary Source="/Themes/ColumnSeries.xaml" />
                <ResourceDictionary Source="/Themes/ComboBox.xaml" />
                <ResourceDictionary Source="/Themes/GroupBox.xaml" />
                <ResourceDictionary Source="/Themes/TextBlock.xaml" />

                <!--Material Design Standard-->
                <!--<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Indigo.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Indigo.xaml" />-->
                <!--Customised-->
                <!--<ResourceDictionary Source="pack://application:,,,/Resources/GeneralResourceGroup.xaml" />-->
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converter:EventArgsConverter x:Key="EventArgsConverter" />
            <converter:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converter:ScrollViewerListConverter x:Key="ScrollViewerListConverter" />

            <Style TargetType="{x:Type liveCharts:CartesianChart}" BasedOn="{StaticResource CartesianChartStyle}" />
            <Style TargetType="{x:Type liveCharts:ColumnSeries}" BasedOn="{StaticResource ColumnSeriesStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>