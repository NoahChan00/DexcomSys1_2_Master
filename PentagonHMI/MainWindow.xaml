<Window x:Class="PentagonHMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PentagonHMI"
         xmlns:uc="clr-namespace:PentagonHMI.UserControls"
        Title="Automated Label Applicator" Height="650" Width="1000" xmlns:my="clr-namespace:PentagonHMI.ChildControls" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources\GlassButton.xaml"/>
                <ResourceDictionary Source="Resources\Checkbox.xaml"/>
                <ResourceDictionary Source="Resources\MenuButton.xaml"/>
                <ResourceDictionary Source="Resources\RoundedButton.xaml"/>
                <ResourceDictionary Source="Resources\TopPanel.xaml"/>
                <ResourceDictionary Source="Resources\TreeView.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
       
    </Window.Resources>
    <Grid>
        <DockPanel Name="dockPanel1" >
            <UniformGrid  Rows="1" DockPanel.Dock="Top" Margin="0" >
                <Grid Background="{DynamicResource TopPanelBrush}" >
                    <Border BorderBrush="#000000" BorderThickness="0 0 2 0" Grid.Row="0" Grid.Column="0"/>
                    <StackPanel Name="SPLogo" VerticalAlignment="Stretch" MinWidth="100" Margin="0">
                        <Image Height="70" Name="Logo_Image" Stretch="Fill" Width="150" Source="/PentagonHMI;component/Images/penta_BIG.png" />
                        <uc:UCLabelTextbox x:Name="uCLabelTextbox2" Text="Operator" ucLabelTitleContent="Login As" />
                        <Button Name="btnSignIn" Content="Sign In" Visibility="Visible" Click="btnSignIn_Click"></Button>
                        <Button Name="Logo_BtnLogout"  Content="Logout" Visibility="Collapsed" Click="Logo_BtnLogout_Click"></Button>

                    </StackPanel>
                </Grid>
                <Grid Background="{DynamicResource TopPanelBrush}">
                    <Border BorderBrush="#000000" BorderThickness="0 0 2 0" Grid.Row="0" Grid.Column="0"/>
	                <StackPanel Name="SPMachine" VerticalAlignment="Stretch" MinWidth="150">
                        <Label Style="{DynamicResource styTopPenal}"  Content="MACHINE" />         
	                    <uc:UCLabelTextbox x:Name="ucMachine_IPAddress" ucLabelTitleContent="IP" MinWidth="150" Text="192.168.1.100" Margin="5,0,5,5"/>
	                    <StackPanel Name="SPMachineDetail1" VerticalAlignment="Top" MinWidth="100" Orientation="Horizontal"  >
	                        <uc:UCCheckboxSmallLabel x:Name="ucMachine_Sing" ucLabelTitleContent="Sing" ucIsCheck="True" ></uc:UCCheckboxSmallLabel>
	                        <uc:UCCheckboxSmallLabel x:Name="ucMachine_FNB" ucLabelTitleContent="FNB" ucIsCheck="True"></uc:UCCheckboxSmallLabel>
	                    </StackPanel> 
	                    <StackPanel Name="SPMachineDetail2" VerticalAlignment="Top" MinWidth="100" Orientation="Horizontal"  >
	                        <uc:UCCheckboxSmallLabel x:Name="ucMachine_UPC" ucLabelTitleContent="UPC" ucIsCheck="True"></uc:UCCheckboxSmallLabel>
	                        <uc:UCCheckboxSmallLabel x:Name="ucMachine_Sorting" ucLabelTitleContent="Sorting" ucIsCheck="True"></uc:UCCheckboxSmallLabel>
	                    </StackPanel>
	                    <uc:UCCheckboxSmallLabel x:Name="ucMachine_Manual" ucLabelTitleContent="Manual"></uc:UCCheckboxSmallLabel>
	                </StackPanel>
				</Grid>
                <Grid Background="{DynamicResource TopPanelBrush}">
                    <Border BorderBrush="#000000" BorderThickness="0 0 2 0" Grid.Row="0" Grid.Column="0"/>
                    <StackPanel Name="SPProduct" VerticalAlignment="Stretch" MinWidth="150">
                        <Label Content="PRODUCT" Style="{DynamicResource styTopPenal}" />                            
                        <uc:UCLabelTextbox x:Name="ucProduct_ID" ucLabelTitleContent="ID" Margin="5,0,5,5" Text="A1416"/>
                        <uc:UCLabelTextbox x:Name="ucProduct_Type" ucLabelTitleContent="Type" Margin="5,0,5,5" Text="IPad Wifi 32GB Black"/>
                        <uc:UCLabelTextbox x:Name="ucProduct_MPN" ucLabelTitleContent="MPN" Margin="5,0,5,5" Text="MC707LL/A"/>
                        <uc:UCLabelTextbox x:Name="ucProduct_Lot" ucLabelTitleContent="Lot" Margin="5,0,5,5" Text="LOT213232"/>
                        <uc:UCLabelTextbox x:Name="ucProduct_Template" ucLabelTitleContent="Template" Margin="5,0,5,5" Text="IPad Wifi"/>
                    </StackPanel>
                </Grid>
                <Grid Background="{DynamicResource TopPanelBrush}">
                    <Border BorderBrush="#000000" BorderThickness="0 0 2 0" Grid.Row="0" Grid.Column="0"/>
                    <StackPanel Name="SPSFS" VerticalAlignment="Stretch" MinWidth="150">
                        <Label Content="SFS" Style="{DynamicResource styTopPenal}"/>                            
                        <uc:UCLabelTextbox x:Name="ucSFS_IP" ucLabelTitleContent="IP" Text="192.168.1.7" />
                        <uc:UCCheckboxSmallLabel x:Name="ucSFS_Status" ucLabelTitleContent="Conn Status"  ucIsCheck="True"></uc:UCCheckboxSmallLabel>
                        <uc:UCLabelTextbox x:Name="ucSFSResponse" ucLabelTitleContent="Response" Margin="0,0,5,5" Height="24" />
                        <Label Content="20-11-2012 10:10:10 Box 123" Height="28" Name="label1" Foreground="White"/>
                    </StackPanel>
                </Grid>
                <Grid Background="{DynamicResource TopPanelBrush}">
                    
                    <UniformGrid Rows="2">
                        <UniformGrid Rows="1" >
                            <Button Style="{DynamicResource CircleButton}" Background="LimeGreen" Content="Start" Name="ucStatus_btnStart"/>
                            <Button Style="{DynamicResource CircleButton}" Background="Salmon" Content="Stop" Name="ucStatus_btnStop" />
                        </UniformGrid>
                        <Label Content="Emergency Stop" Foreground="Snow" FontSize="25" HorizontalContentAlignment="Center"/>                        
                    </UniformGrid>
                </Grid>
            </UniformGrid>

            <Grid DockPanel.Dock="Left"  Width="200">

                <TreeView Name="TVLeftPanel"   TreeViewItem.Selected="OnItemSelected" >
                    <!--<ToggleButton Style="{DynamicResource ExpandCollapseToggleStyle}">
                        
                    </ToggleButton>-->
                    <TreeViewItem Selected="TreeViewItem_Selected_1" VerticalContentAlignment="Center"  Style="{DynamicResource styTreeViewParent}">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image  Height="30" Width="30" Source="/PentagonHMI;component/Images/home-black.png"></Image>
                                <TextBlock Text="Home" VerticalAlignment="Center" FontSize="14"></TextBlock>
                            </StackPanel>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                    <TreeViewItem  Style="{DynamicResource styTreeViewParent}">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal" >
                                <Image  Height="30" Width="30" Source="/PentagonHMI;component/Images/module-black.png"></Image>
                                <TextBlock Text="Module" VerticalAlignment="Center" FontSize="14"></TextBlock>
                            </StackPanel>
                        </TreeViewItem.Header>
                        <TreeViewItem Selected="TreeViewItem_Selected_3" Style="{DynamicResource styTreeViewChild}">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image  Height="30" Width="30" Source="/PentagonHMI;component/Images/home.png"></Image>
                                    <TextBlock Text="Singulation" VerticalAlignment="Center" FontSize="14"></TextBlock>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                        <TreeViewItem Selected="TreeViewItem_Selected_2" Style="{DynamicResource styTreeViewChild}">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image  Height="30" Width="30" Source="/PentagonHMI;component/Images/home.png"></Image>
                                    <TextBlock Text="F&amp;B" VerticalAlignment="Center" FontSize="14"></TextBlock>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                        <TreeViewItem Name="tviUPC" Selected="tviUPC_Selected" Style="{DynamicResource styTreeViewChild}">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image  Height="30" Width="30" Source="/PentagonHMI;component/Images/home.png"></Image>
                                    <TextBlock Text="UPC" VerticalAlignment="Center" FontSize="14"></TextBlock>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                        <TreeViewItem Selected="TreeViewItem_Selected_4" Style="{DynamicResource styTreeViewChild}">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image  Height="30" Width="30" Source="/PentagonHMI;component/Images/home.png"></Image>
                                    <TextBlock Text="Sorting" VerticalAlignment="Center" FontSize="14"></TextBlock>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem>
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image  Height="30" Width="30" Source="/PentagonHMI;component/Images/vision.png"></Image>
                                <TextBlock Text="Vision" VerticalAlignment="Center" FontSize="14"></TextBlock>
                            </StackPanel>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                    <TreeViewItem>
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image  Height="30" Width="30" Source="/PentagonHMI;component/Images/setting-black.png"></Image>
                                <TextBlock Text="Machine Setting" VerticalAlignment="Center" FontSize="14"></TextBlock>
                            </StackPanel>
                        </TreeViewItem.Header>
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image  Height="30" Width="30" Source="/PentagonHMI;component/Images/home.png"></Image>
                                    <TextBlock Text="User Management" VerticalAlignment="Center" FontSize="14"></TextBlock>
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                        <TreeViewItem Header="Middleware"></TreeViewItem>
                        <TreeViewItem Header="Alarm"></TreeViewItem>
                        <TreeViewItem Header="IO Input"></TreeViewItem>
                        <TreeViewItem Header="IO Output"></TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem>
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image  Height="30" Width="30" Source="/PentagonHMI;component/Images/Recipe.png"></Image>
                                <TextBlock Text="Recipe Setting" VerticalAlignment="Center" FontSize="14"></TextBlock>
                            </StackPanel>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                    <TreeViewItem >
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Image  Height="30" Width="30" Source="/PentagonHMI;component/Images/Statistic.png"></Image>
                                <TextBlock Text="Statistic" VerticalAlignment="Center" FontSize="14"></TextBlock>
                            </StackPanel>
                        </TreeViewItem.Header>
                        <TreeViewItem Header="OEE"></TreeViewItem>
                        <TreeViewItem Header="Yield"></TreeViewItem>                        
                    </TreeViewItem>                  
                </TreeView>
            </Grid>
            <!--<UniformGrid Columns="1" DockPanel.Dock="Left">
                <Button Width="150" Content="left 1"></Button>
                <Button Width="150" Content="left 2"></Button>
                <Button Width="150" Content="left 3"></Button>
                <Button Width="150" Content="left 4"></Button>
                <Button Width="150" Content="left 5"></Button>
            </UniformGrid>-->

            <Grid DockPanel.Dock="Bottom" Height="150">
                <StackPanel>
                    <Label Content="Event Log" FontWeight="Bold"></Label>
                    <DataGrid Name="dgDisplay" AutoGenerateColumns="False"  ItemsSource="{Binding}"  IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding LogDatetime}" Header="Date/time" />
                            <DataGridTextColumn Binding="{Binding LogDescription}" Header="LogType"/>
                            <DataGridTextColumn Binding="{Binding LogUser}" Header="Descriptions" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
            <Grid Name="ChildContainer" DockPanel.Dock="Right">
                
            </Grid>
        </DockPanel>
       
    </Grid>
</Window>
