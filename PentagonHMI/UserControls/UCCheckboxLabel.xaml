<UserControl x:Class="PentagonHMI.UserControls.UCCheckboxLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Name="ucIOCheckbox">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Resources\Checkbox.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="27">
        <Label Margin="19,1,5,3" Name="ucLabelTitle" MinWidth="200" Content="{Binding ElementName=ucIOCheckbox, Path=ucLabelTitleContent}" Height="30" />
        <CheckBox Style="{DynamicResource styCheckBox}" HorizontalAlignment="Left" Margin="0,3,0,5" Name="ucCheckBox" Checked="ucCheckBox_Checked" Unchecked="ucCheckBox_Unchecked" PreviewMouseLeftButtonUp="ucCheckBox_PreviewMouseLeftButtonUp" />
    </Grid>
</UserControl>