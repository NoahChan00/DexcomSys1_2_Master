<UserControl x:Class="PentagonHMI.UserControls.UCPallet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Pallet" TargetType="Rectangle">
            <Setter Property="Fill" Value="Black" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="80" />
            <!--<Setter Property="Opacity" Value="0.6" />-->
        </Style>

        <Style x:Key="Tray" TargetType="Rectangle">
            <Setter Property="Fill" Value="Silver" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="70" />
            <Setter Property="Stroke" Value="Gray" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal">
            <Grid Width="38">
                <Rectangle Stroke="White" StrokeThickness="1" Name="LeftPallet" Style="{StaticResource Pallet}" />
            </Grid>
            <Grid Margin="-1 0 0 0" Width="38">
                <Rectangle Stroke="White" StrokeThickness="1" Name="RightPallet" Style="{StaticResource Pallet}" />
            </Grid>
        </StackPanel>
        <Grid Name="Tray" Visibility="Collapsed">
            <Rectangle Name="TrayRec" Stroke="White" Style="{StaticResource Tray}" />
            <TextBlock Name="OrderID" FontSize="12" MaxWidth="64" Padding="2" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>