<UserControl x:Class="PentagonHMI.UserControls.UCCheckBoxBed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PentagonHMI.UserControls"
             mc:Ignorable="d" Name="ucIOCheck" Width="53" Height="75">
    <UserControl.Resources>

        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Resources\Checkbox.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Center">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="53">
            <StackPanel Orientation="Horizontal">
                <CheckBox Click="Zout_Click" HorizontalAlignment="Left" Margin="1 0 10 0" x:Name="Zin" Style="{DynamicResource styCheckBox}">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
                <CheckBox Click="Zout_Click" HorizontalAlignment="Right" Margin="10 0 0 0" x:Name="Zout" Style="{DynamicResource styCheckBox}">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
            </StackPanel>
            <CheckBox Click="Zout_Click" HorizontalAlignment="Center" Margin="0 20 0 0" x:Name="Zpresent" Style="{DynamicResource styCheckBox}">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                </CheckBox.LayoutTransform>
            </CheckBox>
            <Label  Name="ZoneStatus" Width="49" Height="17" Background="Transparent" VerticalAlignment="Top" Margin="0,10" FontSize="7"    HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="4"  HorizontalAlignment="Center" FontWeight="Bold" ></Label>
        </StackPanel>
    </Grid>
</UserControl>