            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style TargetType="Image" x:Key="Background">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Image" x:Key="Icon">
            <Setter Property="Canvas.Top" Value="0" />
            <Setter Property="Canvas.Left" Value="0" />
            <EventSetter Event="MouseLeftButtonDown" Handler="Paging_MouseLeftButtonDown" />
        </Style>

        <Style TargetType="Image" x:Key="Menu">
            <Setter Property="Margin" Value="22 5 22 5" />
            <Setter Property="Width" Value="270" />
            <EventSetter Event="MouseLeftButtonDown" Handler="Image_MouseLeftButtonDown" />
        </Style>

        <Style TargetType="Grid" x:Key="Grid">
