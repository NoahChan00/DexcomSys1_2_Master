            <Setter Property="Height" Value="600" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Visible" />
        </Style>

        <Style TargetType="Ellipse">
            <Setter Property="Width" Value="23" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Stroke" Value="LawnGreen" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>

        <Style TargetType="Line">
            <Setter Property="Stroke" Value="LawnGreen" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Content" Value="Main Menu" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="20" />
            <EventSetter Event="Click" Handler="Button_Click" />
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <ScaleTransform CenterX="75" CenterY="25"  ScaleX="0.9" ScaleY="0.9" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Polygon" x:Key="General">
            <Style.Triggers>
                <EventTrigger RoutedEvent="Polygon.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="0.1" AutoReverse="True" Duration="0:0:2" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
            <Setter Property="Fill" Value="LawnGreen" />
            <Setter Property="Opacity" Value="0.5" />
            <EventSetter Event="MouseLeftButtonDown" Handler="Paging_MouseLeftButtonDown" />
        </Style>

