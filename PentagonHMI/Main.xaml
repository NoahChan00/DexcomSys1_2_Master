<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:PentagonHMI.UserControls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Class="PentagonHMI.Main"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:local="clr-namespace:PentagonHMI"
        xmlns:liveCharts="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="HMI" Height="1080" Width="1920" Icon="/HMI;component/Pentamaster.ico" 
    WindowStyle="ThreeDBorderWindow"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    >
    <Window.Resources>
        <Style x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_DATETIME_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_DATETIME}" />
        </Style>
        <Style x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_USER_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_USER}" />
        </Style>
        <Style x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_LOG_TYPE_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_LOG_TYPE}" />
        </Style>
        <Style x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_DESCRIPTION_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_DESCRIPTION}" />
        </Style>
        <Style x:Key="MAIN_WINDOW_DATATABLE_MESSAGE_HEADER_DATETIME_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="{DynamicResource MAIN_WINDOW_DATATABLE_MESSAGE_HEADER_DATETIME}" />
        </Style>
        <Style x:Key="MAIN_WINDOW_DATATABLE_MESSAGE_HEADER_ERROR_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="{DynamicResource MAIN_WINDOW_DATATABLE_MESSAGE_HEADER_ERROR}" />
        </Style>
        <Style x:Key="MAIN_WINDOW_DATATABLE_MESSAGE_HEADER_ERRORCODE_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="Module" />
        </Style>
        <Style x:Key="MAIN_WINDOW_DATATABLE_MESSAGE_HEADER_ACTION_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="{DynamicResource MAIN_WINDOW_DATATABLE_MESSAGE_HEADER_ACTION}" />
        </Style>
        <Storyboard x:Key="sbShowRightMenu" >
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,5,-240,5" To="0,5,5,5" DecelerationRatio=".9" Duration="0:0:1" />
        </Storyboard>
        <Storyboard x:Key="sbHideRightMenu">
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,5,5,5" To="0,5,-240,5" AccelerationRatio=".9" Duration="0:0:1" />
        </Storyboard>

        <Style x:Key="Icon" TargetType="Image">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <Style x:Key="ClickIcon" TargetType="Image" BasedOn="{StaticResource Icon}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <EventSetter Event="MouseLeftButtonDown" Handler="Page_MouseLeftButtonDown"/>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Bord" TargetType="StackPanel">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Width" Value="120"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid x:Name="grid">
            <Grid.RowDefinitions>
                <RowDefinition Height="170" />
                <RowDefinition Height="*" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                <Border CornerRadius="16,16,16,16"  Margin="5,2,5,5">
                    <Grid x:Name="TopPanelGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Grid.RowSpan="3" Grid.Row="0"  Name="Status_Border" CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}"  Margin="0,0,5,0" BorderThickness="2">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0"  Content="Machine Status" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0,0,0,0" Padding="30,2,2,0" />
                                <Label Name="txtStatus" Grid.Row="1"  VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BlueSteelBorderBackground}" Name="Logo" Grid.Column="3"  Grid.Row="0" CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}"  Margin="0,0,0,0" BorderThickness="2">
                            <StackPanel>
                                <Label Content="PENTAMASTER HMI" Height="40" Margin="0,10,0,0" Padding="0" Foreground="Snow" FontSize="25" HorizontalContentAlignment="Center" FontWeight="Bold" />
                                <Label Name="lbl_MachineName" Content="Machine Name" Padding="0" Height="30"  VerticalAlignment="Top" Foreground="Snow" FontSize="24" HorizontalContentAlignment="Center" FontWeight="Bold" />
                                <Label  Name="lblCurrUser" Content="Current User : Operator"  Grid.Row="1" Foreground="Snow" FontWeight="Bold" FontSize="16"  HorizontalAlignment="Center"/>
                                <!--<Label Name="lblVersion" Content="PLC : v1.0.0.0&#9;Vision : v1.0.0.0"  Grid.Row="1" Foreground="Snow" FontWeight="Bold" FontSize="13"  HorizontalAlignment="Center"/>
                                <Label Name="lblHMIVersion" Content="HMI : v1.0.0.0"  Grid.Row="1" Foreground="Snow" FontWeight="Bold" FontSize="13"  HorizontalAlignment="Center"/>-->

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!--<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Label Content="PLC v" Padding="0" Foreground="Snow" FontSize="15"/>
                                        <Label Name="lbl_PLCVersion" Padding="0" Foreground="Snow" FontSize="15"/>
                                    </StackPanel>-->

                                    <!--<StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Label Content="VIS v" Padding="0" Foreground="Snow" FontSize="15"/>
                                        <Label Name="lbl_VisionVersion" Padding="0" Foreground="Snow" FontSize="15"/>
                                    </StackPanel>-->

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Label Content="HMI v" Padding="0" Foreground="Snow" FontSize="15"/>
                                        <Label Name="lbl_HMIVersion" Padding="0" Foreground="Snow" FontSize="15"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Name="GridContainer" Grid.Row="1" Grid.Column="0" Margin="5,0,10,5" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.RowSpan="2" Name="ChildContainer">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="506*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <Border Name="loginScreen" Height="230" Width="450" VerticalAlignment="Center" Grid.RowSpan="2" HorizontalAlignment="Center" CornerRadius=" 12,12,12,12" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}"  Grid.Row="0" Background="White" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="417*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <Label x:Name="lblTitle" Content="{DynamicResource LOGIN_WINDOW_TITLE}" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Padding="30,2,2,0" Grid.ColumnSpan="2" />
                        <Grid Grid.Row="1" Margin="0,5,0,0" Grid.ColumnSpan="2">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Height="23" Name="txtBlockInstructions" Text="{DynamicResource LOGIN_TEXTBLOCK_INSTRUCTIONS}" Margin="5" />
                                <uc:UCLabelTextboxErrorMessage x:Name="ucUsername" ucLabelErrorContent="" ucLabelTitleContent="{DynamicResource LOGIN_LABEL_USERNAME}"  />
                                <uc:UCLabelTextboxErrorMessage x:Name="ucPassword" ucLabelErrorContent="" ucLabelTitleContent="{DynamicResource LOGIN_LABEL_PASSWORD}" isPassword="True"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                            <Grid Margin="0,5,0,0">
                                <Button Content="{DynamicResource LOGIN_BUTTON_SIGNIN}" Margin="0,0,88,0" Name="btnSignIn" Width="76" Click="btnLogIn_Click" HorizontalAlignment="Right" Background="{DynamicResource NormalBackgroundBrush}" Foreground="{DynamicResource ResourceKey=NormalForegroundBrush}" Style="{DynamicResource styGlassButton}" IsDefault="True" Height="23" VerticalAlignment="Top" />
                                <Button HorizontalAlignment="Right" Margin="0,0,6,0" Name="btnCancel" Width="76" Height="23" VerticalAlignment="Top" Click="btnCancel_Click" Content="{DynamicResource LOGIN_BUTTON_CANCEL}" Background="{DynamicResource NormalBackgroundBrush}" Foreground="{DynamicResource ResourceKey=NormalForegroundBrush}" Style="{DynamicResource styGlassButton}"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid  Background="White" Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Margin="0,0,5,5">
                <Border CornerRadius="16,16,16,16" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Label Content="Menu" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="30,2,2,0" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <WrapPanel HorizontalAlignment="Center" Orientation="Vertical">

                                <!--LOGIN/LOGOUT-->
                                <StackPanel Name="SP_Login" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Tag="Login" Name="Img_Login" Source="/HMI;component/Icon/Log%20In.png" Style="{StaticResource ClickIcon}" Margin="0,1,0,-1"/>
                                        <Image Tag="Logout" Name="Img_Logout" Source="/HMI;component/Icon/LogOut.png" Visibility="Collapsed" Style="{StaticResource ClickIcon}"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Name="TXT_Login" Text="Log in" Style="{StaticResource Title}"/>
                                        <TextBlock Name="TXT_Logout" Text="Log out" Visibility="Collapsed" Style="{StaticResource Title}" />
                                    </Grid>
                                </StackPanel>

                                <!--USERACCOUNT-->
                                <StackPanel Name="SP_User" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Tag="User" Name="Img_User" Source="/HMI;component/Icon/User_New.png" Style="{StaticResource ClickIcon}" />
                                        <Image Name="Img_UserDis" Source="/HMI;component/Icon/UserDis_new.png" Style="{StaticResource Icon}" />
                                    </Grid>
                                    <TextBlock Text="User Account" Style="{StaticResource Title}" />
                                </StackPanel>

                                <!--HOME-->
                                <StackPanel Name="SP_Home" Style="{StaticResource Bord}">
                                    <Image Tag="Home" Source="/HMI;component/Icon/homepage.png" Style="{StaticResource ClickIcon}"/>
                                    <TextBlock Text="Home" Style="{StaticResource Title}" />
                                </StackPanel>

                                <!--LOGS-->
                                <StackPanel Name="Sp_Log" Style="{StaticResource Bord}">
                                    <Image Tag="Log" Source="/HMI;component/Icon/log-icon.png" Style="{StaticResource ClickIcon}"/>
                                    <TextBlock Text="Logs" Style="{StaticResource Title}" />
                                </StackPanel>

                                <!--OEE-->
                                <StackPanel Name="Sp_OEEShift" Style="{StaticResource Bord}">
                                    <Image Tag="SOEE" Source="/HMI;component/Icon/LOTEntry.png" Style="{StaticResource ClickIcon}"/>
                                    <TextBlock Text="Shift OEE" Style="{StaticResource Title}"/>
                                </StackPanel>
                                
                                <StackPanel Name="Sp_OEELot" Style="{StaticResource Bord}">
                                    <Image Tag="LOEE" Source="/HMI;component/Icon/LOTEntry.png" Style="{StaticResource ClickIcon}"/>
                                    <TextBlock Text="Lot OEE" Style="{StaticResource Title}"/>
                                </StackPanel>

                                <StackPanel Visibility="Collapsed" x:Name="RejectBinDisplayStackPanel" Style="{StaticResource Bord}">
                                    <Image Style="{StaticResource ClickIcon}" Source="/HMI;component/Icon/gear.png" Tag="RejectBinDisplay"/>
                                    <TextBlock Style="{StaticResource Title}" Text="Reject Bin"/>
                                </StackPanel>

                                <StackPanel x:Name="sp_TrayMap" Style="{StaticResource Bord}">
                                    <Image Style="{StaticResource ClickIcon}" Source="/HMI;component/Icon/gear.png" Tag="TrayMap"/>
                                    <TextBlock Style="{StaticResource Title}" Text="Tray Map"/>
                                </StackPanel>
                                
                                <StackPanel x:Name="sp_Stacker" Style="{StaticResource Bord}">
                                    <Image Style="{StaticResource ClickIcon}" Source="/HMI;component/Icon/gear.png" Tag="Stacker"/>
                                    <TextBlock Style="{StaticResource Title}" Text="Stacker"/>
                                </StackPanel>

                                <!--DUT Move to main view-->
                                <!--<StackPanel x:Name="sp_DUT" Style="{StaticResource Bord}">
                                    <Image Style="{StaticResource ClickIcon}" Source="/HMI;component/Icon/gear.png" Tag="DUT"/>
                                    <TextBlock Style="{StaticResource Title}" Text="DUT"/>
                                </StackPanel>-->
                                
                                <StackPanel x:Name="sp_Lot" Style="{StaticResource Bord}">
                                    <Image Style="{StaticResource ClickIcon}" Source="/HMI;component/Icon/gear.png" Tag="LOT"/>
                                    <TextBlock Style="{StaticResource Title}" Text="Lot Entry"/>
                                </StackPanel>

                                <!--SETTING-->
                                <StackPanel Name="Sp_Setting" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Tag="Setting" Source="/HMI;component/Icon/Setting.png" Style="{StaticResource ClickIcon}" />
                                        <Image Name="Img_SettingDis" Source="/HMI;component/Icon/Setting1.png"  Style="{StaticResource Icon}" />
                                    </Grid>
                                    <TextBlock Text="Settings" Style="{StaticResource Title}" />
                                </StackPanel>

                                <!--ALARM-->
                                <StackPanel Visibility="Collapsed" Name="Sp_AlmCfg" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Tag="Alarm" Source="/HMI;component/Icon/AlarmConfig.png" Style="{StaticResource ClickIcon}"/>
                                        <Image Name="Img_AlmDis" Source="/HMI;component/Icon/AlarmConfig1.png" Style="{StaticResource Icon}" />
                                    </Grid>
                                    <TextBlock Text="Alarm Config" Style="{StaticResource Title}" />
                                </StackPanel>

                                <!--MOTOR-->
                                <StackPanel Name="Sp_Motor" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Tag="Motor" Source="/HMI;component/Icon/gear.png"  Style="{StaticResource ClickIcon}"/>
                                        <Image Name="Img_MotorDis" Source="/HMI;component/Icon/gear1.png" Style="{StaticResource Icon}" />
                                    </Grid>
                                    <TextBlock Text="Motor" Style="{StaticResource Title}"/>
                                </StackPanel>

                                <!--IOLOCATION-->
                                <StackPanel Visibility="Collapsed" Name="Sp_IOLoc" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Tag="IOLoc" Source="/HMI;component/Icon/iolocation.png" Style="{StaticResource ClickIcon}"/>
                                        <Image Name="Img_IOLocDis" Source="/HMI;component/Icon/iolocation_1.png" Style="{StaticResource Icon}" />
                                    </Grid>
                                    <TextBlock Text="I/O Location" Style="{StaticResource Title}" />
                                </StackPanel>

                                <!--IOLIST-->
                                <StackPanel Name="Sp_IOList" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Tag="IO" Source="/HMI;component/Icon/IO%20list.png" Style="{StaticResource ClickIcon}"/>
                                        <Image Name="Img_IOListDis" Source="/HMI;component/Icon/IO%20list_1.png" Style="{StaticResource Icon}" />
                                    </Grid>
                                    <TextBlock Text="I/O List" Style="{StaticResource Title}" />
                                </StackPanel>

                                <!--DRYRUN-->
                                <StackPanel x:Name="DryrunStackPanel" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Style="{StaticResource ClickIcon}" Source="/Icon/MainTemp.png" Tag="Dryrun"/>
                                        <Image Name="Img_DryrunDis" Source="/HMI;component/Icon/MainTemp_Disable.png" Style="{StaticResource Icon}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Title}" Text="Dryrun"/>
                                </StackPanel>

                                <!--COMPONENTLIFECYCLE-->
                                <StackPanel Visibility="Collapsed" x:Name="ComponentLifeCycleStackPanel" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Style="{StaticResource ClickIcon}" Source="/Icon/CLC.png" Tag="ComponentLifeCycle"/>
                                        <Image Name="Img_ClcDis" Source="/HMI;component/Icon/CLCOFF.png" Style="{StaticResource Icon}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Title}">
                                        Component <LineBreak/> Life Cycle
                                    </TextBlock>
                                </StackPanel>

                                <!--ENGINEERING-->
                                <StackPanel x:Name="EngineeringStackPanel" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Style="{StaticResource ClickIcon}" Source="/Icon/Engineering.png" Tag="Engineering"/>
                                        <Image Name="Img_EngineeringDis" Source="/HMI;component/Icon/Engineering_Dis.png" Style="{StaticResource Icon}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Title}" Text="Engineering" />
                                </StackPanel>

                                <StackPanel Visibility="Collapsed" x:Name="RackConfigurationStackPanel" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Style="{StaticResource ClickIcon}" Source="/HMI;component/Icon/gear.png" Tag="RackConfiguration"/>
                                        <Image x:Name="RackConfigurationDisableImage" Style="{StaticResource Icon}" Source="/HMI;component/Icon/gear1.png"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Title}" Text="Rack Config"/>
                                </StackPanel>

                                <StackPanel Visibility="Collapsed" x:Name="RecipeConfigurationStackPanel" Style="{StaticResource Bord}">
                                    <Grid>
                                        <Image Style="{StaticResource ClickIcon}" Source="/HMI;component/Icon/gear.png" Tag="RecipeConfiguration"/>
                                        <Image x:Name="RecipeConfigurationDisableImage" Style="{StaticResource Icon}" Source="/HMI;component/Icon/gear1.png"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Title}" Text="Recipe Config"/>
                                </StackPanel>

                                <StackPanel Visibility="Collapsed" x:Name="AboutStackPanel" Style="{StaticResource Bord}">
                                    <Image Style="{StaticResource ClickIcon}" Source="/Icon/Info.png" Tag="ABOUT"/>
                                    <TextBlock Style="{StaticResource Title}" Text="About"/>
                                </StackPanel>
                            </WrapPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Name="AlertWarning" Grid.Row="2"  Margin="5,0,10,5">
                <Border  CornerRadius="16,16,16,16"  BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" >
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0"
                        Style="{DynamicResource styTopPenalBlue}"
                        Content="{DynamicResource MAIN_WINDOW_SUB_MENU_HEADER_ALERT_WARNING}"
                        FontSize="18"
                        Height="30"
                        Padding="30,2,2,0"
                        Margin="0, 0, 0, 0"
                        VerticalAlignment="Top">
                        </Label>
                        <ScrollViewer Grid.Row="1"
            VerticalScrollBarVisibility="Hidden"
            Height="auto"
            Margin="0, 0, 0, 0">
                            <DataGrid Margin="5" Name="dgAlertWarning" FontSize="14" AutoGenerateColumns="False" ItemsSource="{Binding}" MaxHeight="160" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding msgDatetime}" Header="Date/Time"  SortDirection="Descending" FontSize="14" />
                                    <DataGridTextColumn Binding="{Binding msgModule}" Header="Module" FontSize="14" />
                                    <DataGridTextColumn Binding="{Binding msgErrorCode}" Header="Error Code" FontSize="14" />
                                    <DataGridTextColumn Binding="{Binding msgError}" Header="Error/Warning " FontSize="14" />
                                    <DataGridTextColumn Binding="{Binding msgAction}" Header="Action" FontSize="14" />
                                    <DataGridTextColumn Binding="{Binding msgView}" Header="" FontSize="14" Foreground="Blue" FontStyle="Italic"/>
                                    <!--0729-->
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
            <Grid Name="Grd_FullScreenPage" Visibility="Collapsed" Background="White" Grid.ColumnSpan="2" Grid.RowSpan="3">
                <Canvas>
                    <Image Canvas.Left="-34" Canvas.Top="200" Width="2000" Source="pack://application:,,,/Images/MainHMI/ArcadiaLine.png"/>

                    <!--Machine Status Block-->
                    <Grid Name="Grd_TrayPlacement" Canvas.Top="250" Height="210" Width="415">
                        <Rectangle Name="Rec_TrayPlacement" Fill="Red" Opacity="0.7"/>
                        <TextBlock Name="Tbk_TrayPlacement" Foreground="Black" Text="Alarm" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="5" FontSize="18" Background="White"/>
                    </Grid>
                    <TextBlock Canvas.Top="219" Text="Tray Placement" Width="415" FontSize="15" Foreground="White" Background="Black" Padding="10 5"/>

                    <Grid Name="Grd_Label" Canvas.Top="380" Canvas.Left="416" Height="345" Width="121">
                        <Rectangle Name="Rec_Label" Fill="Red" Opacity="0.7"/>
                        <TextBlock Name="Tbk_Label"  Foreground="Black" Text="Alarm" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="5" FontSize="18" Background="White"/>
                    </Grid>
                    <TextBlock Canvas.Top="349" Canvas.Left="416" Width="121" Text="Labelling" FontSize="15" Foreground="White" Background="Black" Padding="10 5"/>

                    <Grid Name="Grd_Mobo" Canvas.Top="380" Canvas.Left="538" Height="345" Width="127">
                        <Rectangle Name="Rec_Mobo" Fill="Red" Opacity="0.7"/>
                        <TextBlock Name="Tbk_Mobo"  Foreground="Black" Text="Alarm" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="5" FontSize="18" Background="White"/>
                    </Grid>
                    <TextBlock Canvas.Top="349" Canvas.Left="538" Width="127" Text="Mobo" FontSize="15" Foreground="White" Background="Black" Padding="10 5"/>

                    <Grid Name="Grd_CentralVision" Canvas.Top="380" Canvas.Left="538" >
                        <StackPanel>
                            <Rectangle Name="Rec_CentralVision" HorizontalAlignment="Right" Height="346" Width="59" Fill="Red" Opacity="0.7"/>
                            <Grid>
                                <Rectangle Name="Rec_CentralVision_2" Height="45" Width="187" Opacity="0.7"
                                           Fill="{Binding ElementName =Rec_CentralVision, Path=Fill}"/>
                                <TextBlock Name="Tbk_CentralVision"  Foreground="Black" Text="Alarm" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="5" FontSize="18" Background="White"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <TextBlock Canvas.Top="772" Canvas.Left="538" Text="Centralize Vision" Width="187" FontSize="15" Foreground="White" Background="Black" Padding="10 5"/>

                    <Grid Name="Grd_Power" Canvas.Top="380" Canvas.Left="726" Height="345" Width="125">
                        <Rectangle Name="Rec_Power" Fill="Red" Opacity="0.7"/>
                        <TextBlock Name="Tbk_Power"  Foreground="Black" Text="Alarm" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="5" FontSize="18" Background="White"/>
                    </Grid>
                    <TextBlock Canvas.Top="349" Canvas.Left="726" Width="125" Text="Power Cable" FontSize="15" Foreground="White" Background="Black" Padding="10 5"/>

                    <Grid Name="Grd_40mmFan" Canvas.Top="380" Canvas.Left="852" Height="345" Width="130">
                        <Rectangle Name="Rec_40mmFan" Fill="Red" Opacity="0.7"/>
                        <TextBlock Name="Tbk_40mmFan"  Foreground="Black" Text="Alarm" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="5" FontSize="18" Background="White"/>
                    </Grid>
                    <TextBlock Canvas.Top="349" Canvas.Left="852" Width="130" Text="40mm Fan" FontSize="15" Foreground="White" Background="Black" Padding="10 5"/>

                    <Grid Name="Grd_Heatsink1" Canvas.Top="380" Canvas.Left="983" Height="345" Width="130">
                        <Rectangle Name="Rec_Heatsink1" Fill="Red" Opacity="0.7"/>
                        <TextBlock Name="Tbk_Heatsink1"  Foreground="Black" Text="Alarm" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="5" FontSize="18" Background="White"/>
