<UserControl x:Class="PentagonHMI.VTC_Modules.ucVTC_Main"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="800" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.RowSpan="2" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}" Margin="5,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Label Content="Rack Status" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="30,2,2,0" />
                    <Grid Grid.Row="1">
                        <Image VerticalAlignment="Top" Width="495" Source="pack://application:,,,/Images/VTC/VTC_Rack.png" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ItemsControl Margin="0 -70 0 0" Name="itmctrl_RackLayout">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MouseDown="lbl_Disable_MouseDown" Tag="{Binding SlotIndex}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Label Opacity="0.7" Padding="5 1" MinWidth="50" Content="{Binding SlotIndex}" FontSize="18" Background="{Binding SlotIdexBackground}" Margin="3 3 0 3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                            <Label Opacity="0.8" Padding="10 1" MinWidth="150" Grid.Column="1" Grid.ColumnSpan="4" FontSize="18" Background="{Binding SlotStatusBackground}" Content="{Binding SlotStatusText}" HorizontalContentAlignment="Center" Margin="3" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Left" Margin="5">
                            <ItemsControl Name="itmctrl_Legend">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border  Margin="5 0 5 5" BorderThickness="1" BorderBrush="Black">
                                        <Label Content="{Binding Mode}" Foreground="{Binding FontColor}" Background="{Binding StatusColor}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="100" Height="30" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Button Click="btn_AbortRack_Click" Height="50" Width="150" Content="Abort Rack" FontSize="18" Padding="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Grid.ColumnSpan="2" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}" Margin="5,0,5,5">
                <Grid Height="200">
                    <Label Content="Hourly UPH" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="30,2,2,0" />

                    <lvc:CartesianChart Margin="0 35 0 0" Series="{Binding SeriesCollection}" LegendLocation="None">
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Count" MinValue="0" LabelFormatter="{Binding YFormatter}" />
                        </lvc:CartesianChart.AxisY>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Past Hours" Labels="{Binding Labels}" />
                        </lvc:CartesianChart.AxisX>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <Border Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Label Content="Conveyor Status" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="30,2,2,0" />

                    <Canvas Grid.Row="1" Margin="0 50 0 0">
                        <Image Width="930" Source="pack://application:,,,/Images/VTC/VTC_Conveyor.png" />

                        <GroupBox Header="Tray Lifer Status" FontSize="20" Canvas.Left="15" Canvas.Top="-45">
                            <TextBlock Name="tbk_TrayLifterStatus" Padding="10" Margin="5" MaxWidth="450" Background="LightGray" TextWrapping="Wrap" Text="Lifter pusher cylinder push Zone B tray" FontSize="25" Grid.Row="1" />
                        </GroupBox>

                        <StackPanel  Canvas.Left="490" Canvas.Top="40">
                            <TextBlock Name="tbk_Loading_AssetTag" Text="ASSET TAG" Background="White" Height="70" Width="140" FontSize="20" Opacity="0.8" Padding="5" TextWrapping="Wrap" />
                            <TextBlock Text="Loading Zone" Background="DimGray" Foreground="White" FontSize="14" Padding="5" />
                        </StackPanel>
                        <StackPanel  Canvas.Left="95" Canvas.Top="160">
                            <TextBlock Name="tbk_Zone2_AssetTag" Text="ASSET TAG"  Background="White" Height="120" Width="110" FontSize="20" Opacity="0.8" Padding="5" TextWrapping="Wrap" />
                            <TextBlock Text="Lifter Zone 2" Background="DimGray" Foreground="White" FontSize="14" Padding="5" />
                        </StackPanel>
                        <StackPanel  Canvas.Left="210" Canvas.Top="160">
                            <TextBlock Name="tbk_Zone1_AssetTag" Text="ASSET TAG" Canvas.Left="210" Canvas.Top="160" Background="White" Height="120" Width="110" FontSize="20" Opacity="0.8" Padding="5" TextWrapping="Wrap" />
                            <TextBlock Text="Lifter Zone 1" Background="DimGray" Foreground="White" FontSize="14" Padding="5" />
                        </StackPanel>
                        <StackPanel  Canvas.Left="355" Canvas.Top="160">
                            <TextBlock Name="tbk_Buffer_AssetTag" Text="ASSET TAG"  Background="White" Height="120" Width="110" FontSize="20" Opacity="0.8" Padding="5" TextWrapping="Wrap" />
                            <TextBlock Text="Buffer Zone" Background="DimGray" Foreground="White" FontSize="14" Padding="5" />
                        </StackPanel>
                        <StackPanel Canvas.Left="505" Canvas.Top="160">
                            <TextBlock Name="tbk_Turn_AssetTag" Text="ASSET TAG" Background="White" Height="120" Width="110" FontSize="20" Opacity="0.8" Padding="5" TextWrapping="Wrap" />
                            <TextBlock Text="Turn Table Zone" Background="DimGray" Foreground="White" FontSize="14" Padding="5" />
                        </StackPanel>
                        <StackPanel Canvas.Left="655" Canvas.Top="160">
                            <TextBlock Name="tbk_Reject2_AssetTag" Text="ASSET TAG" Background="White" Height="120" Width="110" FontSize="20" Opacity="0.8" Padding="5" TextWrapping="Wrap" />
                            <TextBlock Text="Reject Zone 2" Background="OrangeRed" Foreground="White" FontSize="14" Padding="5" />
                        </StackPanel>
                        <StackPanel Canvas.Left="805" Canvas.Top="160">
                            <TextBlock Name="tbk_Reject1_AssetTag" Text="ASSET TAG"  Background="White" Height="120" Width="110" FontSize="20" Opacity="0.8" Padding="5" TextWrapping="Wrap" />
                            <TextBlock Text="Reject Zone 1" Background="OrangeRed" Foreground="White" FontSize="14" Padding="5" />
                        </StackPanel>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>