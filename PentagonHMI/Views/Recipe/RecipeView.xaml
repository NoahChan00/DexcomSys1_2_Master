<UserControl x:Class="PentagonHMI.Views.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity">

    <GroupBox Style="{StaticResource TopHeaderGroupBoxStyle}" Header="Recipe">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                <TextBlock Style="{StaticResource CenterKeyTextBlockStyle}" Text="Position"/>
            </Border>

            <ItemsControl Grid.Row="0" Grid.Column="1" x:Name="FieldListItemsControl" ItemsSource="{Binding FieldListView}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1">
                            <TextBlock Style="{StaticResource CenterKeyTextBlockStyle}" Text="{Binding FieldName}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="0" Grid.Column="2" x:Name="ictrl_ReelType_Title" ItemsSource="{Binding ComboList}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1">
                            <TextBlock Style="{StaticResource CenterKeyTextBlockStyle}" Text="{Binding SelectionName}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="0" Grid.Column="3" x:Name="SelectionListItemsControl" ItemsSource="{Binding SelectionListView}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <UniformGrid Columns="1">
                            <Border BorderBrush="Black" BorderThickness="1">
                                <TextBlock Style="{StaticResource CenterKeyTextBlockStyle}" Text="{Binding SelectionName}"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding SelectionParameterListView}"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="Black" BorderThickness="1">
                                            <TextBlock Style="{StaticResource CenterKeyTextBlockStyle}" Text="{Binding SelectionParameterName}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </UniformGrid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

                      
            <ItemsControl Grid.Row="1" Grid.Column="0" x:Name="RecipeListItemsControl" IsHitTestVisible="False"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1">
                            <TextBox FontSize="15" Text="{Binding Position}" TextAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="1" Grid.Column="1" x:Name="FieldListItemsControl2"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding FieldListView}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Black" BorderThickness="1">
                                        <TextBox FontSize="15" IsReadOnly="{Binding FieldIsReadOnly}" Text="{Binding Field}" Tag="{Binding Index}" >
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="KeyDown">
                                                    <i:InvokeCommandAction Command="{Binding FieldTextChangedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource  
                                                                                    Mode=FindAncestor,
                                                                                    AncestorType={x:Type TextBox},
                                                                                    AncestorLevel=1}}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <ItemsControl Grid.Row="1" Grid.Column="2" x:Name="ictrl_ReelType" 
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding ComboList}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding SelectionParameterListView}" 
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="Black" BorderThickness="1">
                                                    <ComboBox Tag="{Binding Index}" IsEnabled="{Binding SelectionParameterIsEnabled}" Text="{Binding SelectionParameter}" ItemsSource="{Binding ComboSource}">
                                                        <ComboBox.Style>
                                                            <Style TargetType="{x:Type ComboBox}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectionParameterMismatch}" Value="True">
                                                                        <Setter Property="Foreground" Value="Red"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding SelectoinChangedCommand}" 
                                                                                      CommandParameter="{Binding RelativeSource={RelativeSource  
                                                                                                                Mode=FindAncestor,
                                                                                                                AncestorType={x:Type ComboBox},
                                                                                                                AncestorLevel=1}}"/>
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </ComboBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="1" Grid.Column="3" x:Name="RecipeListItemsControl2"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding SelectionListView}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding SelectionParameterListView}" 
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="Black" BorderThickness="1">
                                                    <ComboBox Tag="{Binding Index}" IsEnabled="{Binding SelectionParameterIsEnabled}" Text="{Binding SelectionParameter}" ItemsSource="{Binding ComboSource}">
                                                        <ComboBox.Style>
                                                            <Style TargetType="{x:Type ComboBox}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectionParameterMismatch}" Value="True">
                                                                        <Setter Property="Foreground" Value="Red"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                        <i:Interaction.Triggers>
                                                            <i:EventTrigger EventName="SelectionChanged">
                                                                <i:InvokeCommandAction Command="{Binding SelectoinChangedCommand}" 
                                                                                      CommandParameter="{Binding RelativeSource={RelativeSource  
                                                                                                                Mode=FindAncestor,
                                                                                                                AncestorType={x:Type ComboBox},
                                                                                                                AncestorLevel=1}}"/>
                                                            </i:EventTrigger>
                                                        </i:Interaction.Triggers>
                                                    </ComboBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Columns="1" Margin="600 20" TextElement.FontSize="16">
                <Button x:Name="NewRecipeButton" Style="{StaticResource ButtonStyle}" Content="New Recipe" Click="newRecipeButton_Click"/>

                <Button x:Name="ProceedToFirstRecipeSelectionButton" Style="{StaticResource ButtonStyle}"
                        Content="Proceed To First Recipe Selection" Click="proceedToFirstRecipeSelectionButton_Click"/>

                <Button x:Name="ProceedToSecondRecipeSelectionButton" Style="{StaticResource ButtonStyle}"
                        Content="Proceed To Second Recipe Selection" Click="proceedToSecondRecipeSelectionButton_Click"/>

                <Button x:Name="ProceedToFinalRecipeConfirmationButton" Style="{StaticResource ButtonStyle}"
                        Content="Proceed To Final Recipe Confirmation" Click="proceedToFinalRecipeConfirmationButton_Click"/>

                <Button x:Name="LoadRecipeButton" Style="{StaticResource ButtonStyle}" Content="Load Recipe" Click="loadRecipeButton_Click"/>

                <Button x:Name="ResetButton" Style="{StaticResource ButtonStyle}" Content="Reset" Click="ResetButton_Click"/>
            </UniformGrid>

            <Viewbox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="100 0">
                <TextBlock x:Name="MessageTextBlock" FontWeight="Bold" Foreground="Red"/>
            </Viewbox>
        </Grid>
    </GroupBox>

</UserControl>