<UserControl x:Class="PentagonHMI.Views.LabelSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uc="clr-namespace:PentagonHMI.UserControls" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PentagonHMI.Views"
             TextElement.FontSize="16">
    <Grid>
        <GroupBox Style="{StaticResource TopHeaderGroupBoxStyle}" Header="Label Setup">
            <StackPanel Orientation="Horizontal">
                <GroupBox Header="CONFIGURE &amp; REPRINT OUTPUT LABEL"  HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <DataGrid Margin="15 15 15 0" x:Name="Dgd_LabelHistory" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Dgd_LabelHistory_SelectionChanged"
                           CanUserReorderColumns="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserResizeColumns="False"/>
                            <GroupBox Margin="15 0" Header="DETAILS">
                                <UniformGrid Rows="2">
                                    <UniformGrid Rows="1" Margin="5">
                                        <TextBlock Style="{StaticResource KeyTextBlockStyle}" Text="P Field"/>
                                        <TextBox Name="tbx_Selected_PField" IsReadOnly="True"/>
                                    </UniformGrid>
                                    <UniformGrid Rows="1" Margin="5" Background="LightBlue">
                                        <TextBlock Style="{StaticResource KeyTextBlockStyle}" Text="Q Field"/>
                                        <TextBox Name="tbx_Selected_QField"/>
                                    </UniformGrid>
                                    <UniformGrid Rows="1" Margin="5">
                                        <TextBlock Style="{StaticResource KeyTextBlockStyle}" Text="S Field"/>
                                        <TextBox Name="tbx_Selected_SField" IsReadOnly="True"/>
                                    </UniformGrid>
                                    <UniformGrid Rows="1" Margin="5">
                                        <TextBlock Style="{StaticResource KeyTextBlockStyle}" Text="Z Field"/>
                                        <TextBox Name="tbx_Selected_ZField" IsReadOnly="True"/>
                                    </UniformGrid>
                                </UniformGrid>
                            </GroupBox>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Click="btn_Reprint_Click" Grid.ColumnSpan="3" Content="REPRINT" Margin="15 5" Padding="10"/>
                                <Button Grid.Column="3" Content="REFRESH" Click="Refresh_Click" Padding="10" Margin="0 5 15 5"/>
                            </Grid>
                        </StackPanel>
                        <GroupBox Header="LABEL SETUP" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel>
                                <UniformGrid Rows="1" Margin="5">
                                    <TextBlock Style="{StaticResource KeyTextBlockStyle}" Text="Date"/>
                                    <DatePicker Name="dtp_Date" SelectedDateFormat="Short"/>
                                    <TextBlock/>
                                </UniformGrid>
                                <UniformGrid Rows="1" Margin="5">
                                    <TextBlock Style="{StaticResource KeyTextBlockStyle}" Text="Country of Origin"/>
                                    <TextBox Name="tbx_CountryOfOrigin"/>
                                    <TextBlock/>
                                </UniformGrid>
                                <UniformGrid Rows="1" Margin="5">
                                    <TextBlock Style="{StaticResource KeyTextBlockStyle}" Text="Perso Location"/>
                                    <TextBox Name="tbx_PersoLocation"/>
                                    <TextBlock Visibility="Hidden" Margin="5 0" Text="First Letter Used in Z Field" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                                </UniformGrid>
                                <UniformGrid Rows="1" Margin="5">
                                    <TextBlock Style="{StaticResource KeyTextBlockStyle}" Text="Machine Number"/>
                                    <TextBox Name="tbx_MachineNumber"/>
                                    <TextBlock Visibility="Hidden" Margin="5 0" Text="2 Digits, Used in Z Field" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </GroupBox>


        <Border Name="loginScreen" Height="200" Width="450" VerticalAlignment="Center" Grid.RowSpan="3" HorizontalAlignment="Center" CornerRadius=" 12,12,12,12" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}"  Grid.Row="0" Grid.ColumnSpan="2" Background="White" 
                    Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="417*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Label x:Name="lblTitle" Content="Security Verification" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Padding="30,2,2,0" Grid.ColumnSpan="2" />
                <Grid Grid.Row="1" Margin="0,5,0,0" Grid.ColumnSpan="2">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Height="23" Name="txtBlockInstructions" Text="{DynamicResource LOGIN_TEXTBLOCK_INSTRUCTIONS}" Margin="5" />
                        <uc:UCLabelTextboxErrorMessage x:Name="ucUsername" ucLabelErrorContent="" ucLabelTitleContent="{DynamicResource LOGIN_LABEL_USERNAME}"  />
                        <uc:UCLabelTextboxErrorMessage x:Name="ucPassword" ucLabelErrorContent="" ucLabelTitleContent="{DynamicResource LOGIN_LABEL_PASSWORD}" isPassword="True"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid Margin="0,5,0,0">
                        <Button Content="Continue to Print" Margin="0,0,88,0" Name="btnSignIn" Width="150" Click="btnLogIn_Click" HorizontalAlignment="Right" Background="{DynamicResource NormalBackgroundBrush}" Foreground="{DynamicResource ResourceKey=NormalForegroundBrush}" Style="{DynamicResource styGlassButton}" IsDefault="True" Height="23" VerticalAlignment="Top" />
                        <Button HorizontalAlignment="Right" Margin="0,0,6,0" Name="btnCancel" Width="76" Height="23" VerticalAlignment="Top" Click="btnCancel_Click" Content="{DynamicResource LOGIN_BUTTON_CANCEL}" Background="{DynamicResource NormalBackgroundBrush}" Foreground="{DynamicResource ResourceKey=NormalForegroundBrush}" Style="{DynamicResource styGlassButton}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>