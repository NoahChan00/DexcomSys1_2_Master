<UserControl x:Class="PentagonHMI.Views.UPHView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PentagonHMI.Views"
             xmlns:liveCharts="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">

    <GroupBox Style="{StaticResource TopHeaderGroupBoxStyle}" Header="UPH">
        <liveCharts:CartesianChart x:Name="UPHCartesianChart" DataTooltip="{x:Null}" MouseMove="uPHCartesianChart_MouseMove">
            <liveCharts:CartesianChart.AxisX>
                <liveCharts:Axis Labels="12am, 1am, 2am, 3am, 4am, 5am, 6am, 7am, 8am, 9am, 10am, 11am, 12pm, 1pm, 2pm, 3pm, 4pm, 5pm, 6pm, 7pm, 8pm, 9pm, 10pm, 11pm"
                                 Title="Time">
                    <liveCharts:Axis.Sections>
                        <liveCharts:AxisSection x:Name="UPHXAxisSection" DataLabel="True" DataLabelForeground="White" Fill="#FFFF5722"
                                                SectionOffset="-0.5" SectionWidth="1" Stroke="#FFFF5722" StrokeThickness=".5" />
                    </liveCharts:Axis.Sections>
                    <liveCharts:Axis.Separator>
                        <liveCharts:Separator Step="1" />
                    </liveCharts:Axis.Separator>
                </liveCharts:Axis>
            </liveCharts:CartesianChart.AxisX>
            <liveCharts:CartesianChart.AxisY>
                <liveCharts:Axis x:Name="UPHYAxis" Title="UPH">
                    <liveCharts:Axis.Sections>
                        <liveCharts:AxisSection x:Name="UPHYAxisSection" DataLabel="True" DataLabelForeground="White"
                                                DisableAnimations="True" Panel.ZIndex="1" Stroke="#FFFF5722" StrokeThickness="1" />
                    </liveCharts:Axis.Sections>
                </liveCharts:Axis>
            </liveCharts:CartesianChart.AxisY>
            <liveCharts:CartesianChart.Series>
                <liveCharts:ColumnSeries x:Name="UPHColumnSeries" />
            </liveCharts:CartesianChart.Series>
        </liveCharts:CartesianChart>
    </GroupBox>
</UserControl>