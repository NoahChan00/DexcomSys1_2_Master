<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PentagonHMI.Themes">

    <Style x:Key="ValueTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Padding" Value="4 2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="KeyTextBlockStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ValueTextBlockStyle}">
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    
    <Style x:Key="CenterValueTextBlockStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ValueTextBlockStyle}">
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    
    <Style x:Key="CenterKeyTextBlockStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource KeyTextBlockStyle}">
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>