<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="SolidColorBrush4" Color="#60000000" />
    <RadialGradientBrush x:Key="RadialGradientBrush1" Center="0.5,0.5" GradientOrigin="0.5,0.5" Opacity="50" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="White" Offset="0.1" />
        <GradientStop Color="Red" Offset="0.8" />
        <GradientStop Color="LightSalmon" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="RadialGradientBrush2" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="White" Offset="0.1" />
        <GradientStop Color="Green" Offset="0.8" />
        <GradientStop Color="LightGreen" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="RadialGradientBrush3" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="White" Offset="0.3" />
        <GradientStop Color="#FFFFC200" Offset="0.8" />
        <GradientStop Color="Orange" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="SolidColorBrush6" Color="#EEE" />
    <SolidColorBrush x:Key="SolidColorBrush7" Color="#AAA" />
    <SolidColorBrush x:Key="SolidColorBrush8" Color="#888" />
    <RadialGradientBrush x:Key="RadialGradientBrush4" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="White" Offset="0.3" />
        <GradientStop Color="Red" Offset="0.8" />
        <GradientStop Color="LightSalmon" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="LinearGradientBrush3" EndPoint="0,1" StartPoint="0,0">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#BBB" Offset="0.0" />
                <GradientStop Color="#EEE" Offset="0.1" />
                <GradientStop Color="#EEE" Offset="0.9" />
                <GradientStop Color="#FFF" Offset="1.0" />
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LinearGradientBrush4" EndPoint="0,1" StartPoint="0,0">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#444" Offset="0.0" />
                <GradientStop Color="#888" Offset="1.0" />
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <Style x:Key="IndicatorCheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Border>
                                    <Rectangle Margin="15 0 0 0" Stroke="{DynamicResource SolidColorBrush4}" StrokeDashArray="1 2" StrokeThickness="1" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="10 2" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Border x:Name="Border" Background="{DynamicResource RadialGradientBrush1}" BorderThickness="1"
                                    BorderBrush="{DynamicResource SolidColorBrush5}" CornerRadius="10" Height="20" Width="20">
                                <Ellipse x:Name="CheckMark" Fill="{DynamicResource RadialGradientBrush2}" Height="18" Width="18" />
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="4 0 0 0" HorizontalAlignment="Left" RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource RadialGradientBrush3}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SolidColorBrush6}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource SolidColorBrush7}" />
                            <Setter Property="Foreground" Value="{DynamicResource SolidColorBrush8}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource RadialGradientBrush4}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource LinearGradientBrush3}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource LinearGradientBrush4}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>