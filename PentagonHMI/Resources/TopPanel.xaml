<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="TopPanelBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF6D6D6D" Offset="0.414" />
        <GradientStop Color="#FF6C6C6C" Offset="1" />
        <GradientStop Color="#FF838383" />
        <GradientStop Color="#FF5E5E5E" Offset="0.565" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopPanelTitleBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF2F2F2" Offset="0" />
        <GradientStop Color="Silver" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GridLineBrush" Color="#FF8483AA" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF7D7D7D" />

    <Style x:Key="styTopPenal" TargetType="{x:Type Label}">
        <Setter Property="Background" Value="{StaticResource TopPanelTitleBrush}" />
        <Setter Property="Foreground" Value="#FF7D7D7D" />
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <!--<Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="White" ShadowDepth="3" Direction="300" />
            </Setter.Value>
        </Setter>-->
    </Style>

    <!--<Style x:Key="styTopPenal2" TargetType="{x:Type Label}">
        <Setter Property="Background" Value="{StaticResource TopPanelTitleBrush}" />
        <Setter Property="Foreground" Value="#FF7D7D7D" />
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="White" ShadowDepth="3" Direction="300" />
            </Setter.Value>
        </Setter>
    </Style>-->

    <Style x:Key="styTopPenalBlue" TargetType="{x:Type Label}">
        <!--<Setter Property="Foreground" Value="Snow" />
        <Setter Property="FontSize" Value="18" />

        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Padding" Value="30,2,5,5" />
        <Setter Property="Height" Value="30" />-->

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Label}">
                    <Grid>
                        <Border Name="Bd" CornerRadius="12,12,0,0">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#FF627793" Offset="0" />
                                    <GradientStop Color="#FF234372" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Content="{Binding Path=Content, RelativeSource={RelativeSource AncestorType={x:Type Label}}}" Margin="0,0,0,0"
                                    VerticalAlignment="Top" Foreground="Snow"
                                    Padding="{Binding Path=Padding, RelativeSource={RelativeSource AncestorType={x:Type Label}}}"
                                    HorizontalAlignment="{Binding Path=HorizontalAlignment, RelativeSource={RelativeSource AncestorType={x:Type Label}}}"
                                    HorizontalContentAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type Label}}}"></Label>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="BlueLineBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF627793" Offset="0" />
        <GradientStop Color="#FF234372" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GreenBorderBackground" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="Lime" Offset="0" />
        <GradientStop Color="Green" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedBorderBackground" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="Red" Offset="0" />
        <GradientStop Color="DarkRed" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="YellowBorderBackground" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="Yellow" Offset="0" />
        <GradientStop Color="Gold" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlueBorderBackground" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FF008DFF" Offset="0" />
        <GradientStop Color="Blue" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlueSteelBorderBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF627793" Offset="0" />
        <GradientStop Color="#FF234372" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>