<UserControl x:Class="PentagonHMI.ChildControls.ucUserAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uc="clr-namespace:PentagonHMI.UserControls"
             mc:Ignorable="d"
            d:DesignHeight="641" d:DesignWidth="1035"
             xmlns:my="clr-namespace:PentagonHMI.UserControls">
    <UserControl.Resources>
        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_DATETIME_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter
                Property="Content"
                Value="User ID" />
        </Style>
        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_USER_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter
                Property="Content"
                Value="Password" />
        </Style>
        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_LOG_TYPE_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter
                Property="Content"
                Value="Level" />
        </Style>
        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_DESCRIPTION_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter
                Property="Content"
                Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_DESCRIPTION}" />
        </Style>
    </UserControl.Resources>
    <Border   CornerRadius="16,16,16,16"  BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" Margin="0,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <!--<RowDefinition Height="30" />-->
            </Grid.RowDefinitions>
            <Label Grid.Row="0" x:Name="lblTitle" Content="User Account" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="30,2,2,0" />

            <Grid Grid.Row="1" Margin="20,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <GroupBox Header="Change Password" FontSize="16" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="3">
                                <StackPanel>

                                    <Label Content="User ID" Height="28"  FontSize="16" />
                                    <TextBox Height="30" Name="txtUserid1" Width="150"  Margin="150,-26,0,0"  HorizontalAlignment="Left" />
                                    <Label Content="Old Password" Height="28"  FontSize="16" />

                                    <PasswordBox Height="30" Name="txtPass1" Width="150"  Margin="150,-26,0,0" HorizontalAlignment="Left" />
                                    <!--<TextBox Height="30" Name="txtPass1" Width="150"  Margin="150,-26,0,0" HorizontalAlignment="Left" />-->
                                    <Label Content="New Password" Height="28"  FontSize="16" />
                                    <PasswordBox Height="30" Name="txtNewPass1" Width="150"  Margin="150,-26,0,0" HorizontalAlignment="Left" />
                                    <!--<TextBox Height="30" Name="txtNewPass1" Width="150"  Margin="150,-26,0,0"  HorizontalAlignment="Left" />-->
                                    <Label Content="Confirm Password" Height="28"  FontSize="16" />
                                    <PasswordBox Height="30" Name="txtCNewPass1" Width="150"  Margin="150,-26,0,0" HorizontalAlignment="Left" />
                                    <!--<TextBox Height="30" Name="txtCNewPass1" Width="150"  Margin="150,-26,0,0"  HorizontalAlignment="Left" />-->

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!--<Button Background="{DynamicResource NormalBackgroundBrush}" Content="Reset Attempt" Foreground="{DynamicResource NormalForegroundBrush}" Height="30" Name="btnReset" Style="{DynamicResource styGlassButton}" Width="180" Margin="0,20,10,10" HorizontalAlignment="Right" Click="btnResetAttempt_Click" FontSize="16" />-->
                                        <Button Background="{DynamicResource NormalBackgroundBrush}" Content="Change Password" Foreground="{DynamicResource NormalForegroundBrush}" Height="30" Name="btnChangePassword" Style="{DynamicResource styGlassButton}" Width="180" Margin="0,20,10,10" HorizontalAlignment="Right" Click="btnChangePassword_Click" FontSize="16" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Add User" FontSize="16" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="3" Height="227">
                                <StackPanel>
                                    <Label Content="User Level" Height="28" Name="label1" FontSize="16" VerticalAlignment="Top" />
                                    <ComboBox Height="30" Name="userlevel" Width="150" VerticalAlignment="Top" Margin="150,-26,0,0" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Operator" FontSize="16" />
                                        <ComboBoxItem Content="Technician" FontSize="16" />
                                        <ComboBoxItem Content="Engineer"  FontSize="16" />
                                    </ComboBox>
                                    <Label Content="User ID" Height="28"  FontSize="16" />
                                    <TextBox Height="30" Name="txtUserid" Width="150"  Margin="150,-26,0,0" HorizontalAlignment="Left" />
                                    <Label Content="Password" Height="28"  FontSize="16" />
                                    <PasswordBox Height="30" Name="txtpassword" Width="150"  Margin="150,-26,0,0" HorizontalAlignment="Left" />
                                    <!--<TextBox Height="30" Name="txtpassword" Width="150"  Margin="150,-26,0,0" HorizontalAlignment="Left" />-->
                                    <Label Content="Confirm Password" Height="28"  FontSize="16" />
                                    <PasswordBox Height="30" Name="txtCpassword" Width="150"  Margin="150,-26,0,0" HorizontalAlignment="Left" />

                                    <Button Background="{DynamicResource NormalBackgroundBrush}" Content="Add New" Foreground="{DynamicResource NormalForegroundBrush}" Height="30" Name="btnAddUser" Style="{DynamicResource styGlassButton}" Width="100" Margin="0,20,10,10" HorizontalAlignment="Right" Click="btnAddUser_Click" FontSize="16" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                        <StackPanel  Grid.Column="1">

                            <GroupBox BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="3" Header="Delete ID" FontSize="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="200" />
                                        <RowDefinition Height="40" />
                                        <!--<RowDefinition Height="30" />-->
                                    </Grid.RowDefinitions>
                                    <ScrollViewer
            VerticalScrollBarVisibility="Hidden"
            Height="auto"
            Margin="10, 10, 10, 10">
                                        <DataGrid
                Name="dgLog"
                AutoGenerateColumns="False"
                ItemsSource="{Binding}"
                MaxHeight="200"
                IsReadOnly="True"
                Margin="0, 0, 0, 0"  MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource  Mode=FindAncestor, AncestorType=Grid}}" SelectionChanged="dgLog_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn
                        Binding="{Binding UserName}"
                        HeaderStyle="{StaticResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_DATETIME_STYLE}"
                        SortDirection="Descending" SortMemberPath="UserName" />
                                                <!--<DataGridTextColumn
                        Binding="{Binding Password}"
                        HeaderStyle="{StaticResource
                        MAIN_WINDOW_DATATABLE_EVENT_HEADER_USER_STYLE}" SortMemberPath="Password" />-->
                                                <DataGridTextColumn
                        Binding="{Binding Level}"
                        HeaderStyle="{StaticResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_LOG_TYPE_STYLE}" Width="*" SortMemberPath="Level" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                    <Button Background="{DynamicResource NormalBackgroundBrush}" Grid.Row="1" Content="Delete" Foreground="{DynamicResource NormalForegroundBrush}" Height="30" Name="btnDeleteUser" Style="{DynamicResource styGlassButton}" Width="100" Margin="0,0,10,10" HorizontalAlignment="Right" Click="btnDeleteUser_Click" FontSize="16" />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!--<Grid Grid.Row="2">
        </Grid>-->
        </Grid>
    </Border>
</UserControl>