<UserControl x:Class="PentagonHMI.ChildControls.ucDryrun"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border VerticalAlignment="Top" Grid.Row="0" Grid.Column="0" CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}"  Margin="0,0,5,0" BorderThickness="2">
                <StackPanel VerticalAlignment="Top">
                    <Label Content="Dry Run Mode" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="30,2,2,0" />
                    <ComboBox Name="cbx_DryRunMode" MinWidth="300" FontSize="30" Margin="15" SelectedIndex="0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}"  Margin="0,5,5,0" BorderThickness="2">
                <StackPanel>
                    <Label Content="Control" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="30,2,2,0" />
                    <Button Name="btn_Start" Click="Btn_Start_Click" Content="Start" Margin="15" FontSize="30" Padding="10" />
                    <Label Name="lbl_NoMaterialNote" Padding="20 0 0 0" Content="*Dryrun mode requires No Material" />
                    <Button Name="btn_Stop" Click="Btn_Stop_Click" Content="Stop" Margin="15" FontSize="30" Padding="10" />
                    <Button Name="btn_Reset" Click="Btn_Reset_Click" Content="Reset" Margin="15" FontSize="30" Padding="10" />
                    <Button Visibility="Collapsed" Name="btn_Demo" Content="Demo" HorizontalAlignment="Right" Margin="15" Padding="5" FontSize="20" Click="Demo_Click" />
                </StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" CornerRadius=" 14,14,14,14" BorderBrush="{DynamicResource BlueLineBrush}"  Margin="0,0,5,0" BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.ColumnSpan="2" Content="Dry Run (HH:MM:SS)" Style="{DynamicResource styTopPenalBlue}" Height="30" FontSize="18" Padding="30,2,2,0" />
                    <GroupBox Margin="5" Grid.Row="1" Header="TOTAL DURATION" FontSize="20">
                        <Label Name="lbl_Total" Content="00h:00m:00s" HorizontalAlignment="Right" />
                    </GroupBox>
                    <GroupBox Margin="5" Grid.Row="2" Header="RUN TIME" FontSize="20">
                        <Label Name="lbl_Run" Content="00h:00m:00s" HorizontalAlignment="Right" />
                    </GroupBox>
                    <GroupBox Margin="5" Grid.Row="3" Header="IDLE TIME" FontSize="20">
                        <Label Name="lbl_Idle" Content="00h:00m:00s" HorizontalAlignment="Right" />
                    </GroupBox>
                    <GroupBox Margin="5" Grid.Row="4" Header="DOWN TIME" FontSize="20">
                        <Label Name="lbl_Down" Content="00h:00m:00s" HorizontalAlignment="Right" />
                    </GroupBox>
                    <GroupBox Margin="5" Grid.Row="5" Header="MTBA" FontSize="20">
                        <Label Name="lbl_MTBA" Content="00h:00m:00s" HorizontalAlignment="Right" />
                    </GroupBox>
                    <GroupBox Margin="5" Grid.Row="6" Header="MTBF" FontSize="20">
                        <Label Name="lbl_MTBF" Content="00h:00m:00s" HorizontalAlignment="Right" />
                    </GroupBox>
                    <UniformGrid Rows="1" Grid.Row="7">
                        <GroupBox Margin="5" Grid.Row="4" Header="SOFT JAM" FontSize="20">
                            <Label Name="lbl_SoftJam" Content="0" HorizontalAlignment="Right" />
                        </GroupBox>
                        <GroupBox Margin="5" Grid.Row="4" Header="HARD JAM" FontSize="20">
                            <Label Name="lbl_HardJam" Content="0" HorizontalAlignment="Right" />
                        </GroupBox>
                    </UniformGrid>
                    <GroupBox Margin="5" Header="DRYRUN DURATION (Min) - STACKED AREA CHART (Update every 5 Mins)" FontSize="20" Grid.Column="1" Grid.Row="1" Grid.RowSpan="8">
                        <lvc:CartesianChart Margin="10"
                                                            Grid.Row="2" Series="{Binding SeriesCollections}"
                                                            LegendLocation="Right">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis IsEnabled="False" ShowLabels="False" />
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Dryrun Duration" LabelFormatter="{Binding YFormatter}" />
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </GroupBox>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>