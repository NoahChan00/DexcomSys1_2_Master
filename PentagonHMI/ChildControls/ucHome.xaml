                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <GroupBox Grid.Row="0"  Grid.Column="0" FontSize="18" Header="Total Unit" FontWeight="Bold" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" Margin="5" >
                                    <TextBlock FontSize="40" Text="" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Blue" />
                                 </GroupBox>
                                <GroupBox Grid.Row="1"  Grid.Column="0" FontSize="18" Header="Total Pass" FontWeight="Bold" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" Margin="5" >
                                    <TextBlock FontSize="40" Text="" VerticalAlignment="Center" HorizontalAlignment="Center"  Foreground="Green"/>
                                </GroupBox>
                                <GroupBox Grid.Row="2"  Grid.Column="0" FontSize="18" Header="Total Fail" FontWeight="Bold" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" Margin="5" >
                                    <TextBlock FontSize="40" Text="" VerticalAlignment="Center" HorizontalAlignment="Center"  Foreground="Red" />
                                </GroupBox>
                                <GroupBox Grid.Row="3"  Grid.Column="0" FontSize="18" Header="Yield(%)" FontWeight="Bold" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" Margin="5" >
                                    <TextBlock FontSize="40" Text="" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Lime" />
                                </GroupBox>
                            </Grid>-->

                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>