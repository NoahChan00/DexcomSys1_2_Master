<UserControl x:Class="PentagonHMI.ChildControls.ucEventLog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignHeight="840" d:DesignWidth="1630">
    <UserControl.Resources>
        <Style x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_DATETIME_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_DATETIME}" />
        </Style>
        <Style x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_USER_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_USER}" />
        </Style>
        <Style x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_LOG_TYPE_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_LOG_TYPE}" />
        </Style>
        <Style x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_DESCRIPTION_STYLE" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Content" Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_DESCRIPTION}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border CornerRadius="16,16,16,16" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Content="Logs" Style="{DynamicResource styTopPenalBlue}" Grid.ColumnSpan="2" Height="30" VerticalAlignment="Top"
                        FontSize="18" Margin="0,0,0,0" Padding="30,2,2,0" />

                <Grid Grid.Row="1" Margin="10">
                    <TabControl>

                        <TabItem Name="EventLogTab" Visibility="Collapsed" Header="Event Log">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal">
                                        <DatePicker Margin="10 0 20 0" Height="30" Name="datePickerEvent" VerticalAlignment="Center" Width="250" FontSize="15"
                                                SelectedDateFormat="Long" Focusable="False" />
                                        <Button Name="btnEventSubmit" Style="{DynamicResource styGlassButton}" Background="LightGray"
                                                Foreground="{DynamicResource NormalForegroundBrush}" Width="135" Height="30" Padding="10" Content="Submit"
                                                FontSize="20" Click="BtnEventSubmit_Click" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource styGlassButton}"
                                            Background="LightGray" Foreground="{DynamicResource NormalForegroundBrush}" Width="95" Height="30" Margin="0 0 5 0"
                                            Padding="10" Content="Back" FontSize="20" Click="Button_Click" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Visible" Height="auto" Margin="0, 0, 0, 0">
                                        <DataGrid IsReadOnly="True" Name="gridEventHistory" CanUserAddRows="false" ItemsSource="{Binding}" FontSize="15" />
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </TabItem>

