<UserControl x:Class="PentagonHMI.ChildControls.ucWorkstation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PentagonHMI.ChildControls"
             xmlns:my="clr-namespace:PentagonHMI.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid>
                <Border Grid.Column="0" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}" Margin="0,0,0,0"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Order Info" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="30,2,2,0"/>
                    <StackPanel Grid.Row="1">
                        <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="OrderNo" VerticalAlignment="Top" ucLabelTitleContent="Order No"  ucLabelTitleWidth="120"  Margin="5" ucText="" FontSize="16" Padding="0,10,0,0" />
                        <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="AssetTag" VerticalAlignment="Top" ucLabelTitleContent="Asset Tag"  ucLabelTitleWidth="120"  Margin="5" ucText="" FontSize="16"  />
                        <TextBlock Name="txtOrderStatus" FontSize="16" Foreground="Red" Padding="10,0,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Button Name="btnReset" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource styGlassButton}" Background="LightGray" Foreground="{DynamicResource NormalForegroundBrush}" Width="135" Height="70" Margin="5" Padding="0,0,0,10" Content=" Reset&#xa;Resume" FontSize="23" Click="btnReset_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid>
                <Border Grid.Column="0" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}" Margin="0,0,0,0"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Assemble Part List" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="30,2,2,0"/>
                    <StackPanel Grid.Row="1">
                        <TextBlock>
                        <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="Item_1" VerticalAlignment="Top" ucLabelTitleContent="Assembly Item #1"  ucLabelTitleWidth="150"  Margin="5" ucText="" FontSize="14" />
                        <my:UCLabelTitleLabelDisplay HorizontalAlignment="Left"  x:Name="QtyBad_1" VerticalAlignment="Top" ucLabelTitleContent=""  ucLabelTitleWidth="15"  Margin="5" ucText="" FontSize="14"  />
                        </TextBlock>
                        <TextBlock>
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="Item_2" VerticalAlignment="Top" ucLabelTitleContent="Assembly Item #2"  ucLabelTitleWidth="150"  Margin="5" ucText="" FontSize="14"  />
                        <my:UCLabelTitleLabelDisplay HorizontalAlignment="Left"  x:Name="QtyBad_2" VerticalAlignment="Top" ucLabelTitleContent=""  ucLabelTitleWidth="15"  Margin="5" ucText="" FontSize="14"  />
                        </TextBlock>
                        <TextBlock>
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="Item_3" VerticalAlignment="Top" ucLabelTitleContent="Assembly Item #3"  ucLabelTitleWidth="150"  Margin="5" ucText="" FontSize="14"  />
                        <my:UCLabelTitleLabelDisplay HorizontalAlignment="Left"  x:Name="QtyBad_3" VerticalAlignment="Top" ucLabelTitleContent=""  ucLabelTitleWidth="15"  Margin="5" ucText="" FontSize="14"  />
                        </TextBlock>
                        <TextBlock>
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="Item_4" VerticalAlignment="Top" ucLabelTitleContent="Assembly Item #4"  ucLabelTitleWidth="150"  Margin="5" ucText="" FontSize="14"  />
                        <my:UCLabelTitleLabelDisplay HorizontalAlignment="Left"  x:Name="QtyBad_4" VerticalAlignment="Top" ucLabelTitleContent=""  ucLabelTitleWidth="15"  Margin="5" ucText="" FontSize="14"  />
                        </TextBlock>
                        <TextBlock>
                        <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="Item_5" VerticalAlignment="Top" ucLabelTitleContent="Assembly Item #5"  ucLabelTitleWidth="150"  Margin="5" ucText="" FontSize="14"  />
                        <my:UCLabelTitleLabelDisplay HorizontalAlignment="Left"  x:Name="QtyBad_5" VerticalAlignment="Top" ucLabelTitleContent=""  ucLabelTitleWidth="15"  Margin="5" ucText="" FontSize="14"  />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Name="txtPassFail"/>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
            <Grid>
                <Border Grid.Column="0" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}" Margin="0,0,0,0"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Current Assemble" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="30,2,2,0"/>
                    <StackPanel Grid.Row="1">
                        <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="AsmPart" VerticalAlignment="Top" ucLabelTitleContent="Assembly Item : "  ucLabelTitleWidth="160"  Margin="5" ucText="" FontSize="20"  />
                        <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="QtyBad" VerticalAlignment="Top" ucLabelTitleContent="Bad Qty : "  ucLabelTitleWidth="160"  Margin="5" ucText="" FontSize="20"  />
                        <TextBlock Name="ScanBarcodeBlock" VerticalAlignment="Top" FontSize="20" Margin="0" Padding="10,5,2,0"><Bold> Scan Barcode : </Bold>
                            <TextBox Name="txtBarcode" VerticalAlignment="Top" Width="200" Background="LightGray" FontSize="20" ></TextBox>
                            <Button Name="btnFixScan" Style="{DynamicResource styGlassButton}" Background="LightGray" Foreground="{DynamicResource NormalForegroundBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Width="120" Height="50" Content="Fixture&#xa;Scanner" FontSize="18" Click="btnFixScan_Click"/>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center">
                            <Button Name="btnBad" Style="{DynamicResource styGlassButton}" Background="HotPink" Foreground="{DynamicResource NormalForegroundBrush}" HorizontalAlignment="Stretch" Width="180" Height="80" Margin="15" Content="{DynamicResource WS_BTN_BAD}" FontSize="25" Click="btnBad_Click"/>
                            <!--<Button Name="btnBad" Style="{DynamicResource styGlassButton}" Background="HotPink" Foreground="{DynamicResource NormalForegroundBrush}" HorizontalAlignment="Stretch" Width="180" Height="80" Margin="15" Content="Reject&#xa; Item" FontSize="25" Click="btnBad_Click"/>-->
                            <Button Name="btnOK" Style="{DynamicResource styGlassButton}" Background="LimeGreen" Foreground="{DynamicResource NormalForegroundBrush}" HorizontalAlignment="Stretch" Width="180" Height="80" Margin="15" Content="Next Item"  FontSize="25" IsEnabled="True" Click="btnOK_Click"/>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center"> 
                            <Button Name="btnReject" Style="{DynamicResource styGlassButton}"  Background="HotPink" Foreground="{DynamicResource NormalForegroundBrush}"  Width="180" Height="80" Margin="15" Content="Reject Order"  FontSize="25" IsEnabled="True" Click="btnReject_Click" />    
                            <Button Name="btnPass" Style="{DynamicResource styGlassButton}"  Background="LimeGreen" Foreground="{DynamicResource NormalForegroundBrush}"  Width="180" Height="80" Margin="15" Content="Pass"  FontSize="25" IsEnabled="True" Click="btnPass_Click"/>
                        </TextBlock>
                        <!--<TextBlock HorizontalAlignment="Center">
                            <Button Name="btnReset" Style="{DynamicResource styGlassButton}" Background="LightGray" Foreground="{DynamicResource NormalForegroundBrush}" Width="180" Height="80" Margin="15" Content="Reset/Restart" FontSize="25" Click="btnReset_Click" />
                            <Button Name="btnDummy" Visibility="Hidden" Style="{DynamicResource styGlassButton}" Background="LightGray" Foreground="{DynamicResource NormalForegroundBrush}" Width="180" Height="80" Margin="15" FontSize="25" Content="Dummy" />
                        </TextBlock>-->
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Grid.Column="1" Name="RejectOrderScreen" Height="280" Width="400" VerticalAlignment="Top" HorizontalAlignment="Center" CornerRadius=" 12,12,12,12" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}"   Background="White" Margin="5,5,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Border CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}" Margin="0,0,0,0"/>
                    <Label Content="Reject Order" Style="{DynamicResource styTopPenalBlue}" Height="25" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="10,0,0,0"/>
                </Grid>
                <Grid Grid.Row="1">
                    <ScrollViewer>
                        <TextBlock Name="txt_Msg" Padding="10,5,0,0"/>
                    </ScrollViewer>
                </Grid>
                <Grid Grid.Row="2">
                    <StackPanel>
                    <Label Content="Remarks : " FontSize="14" FontWeight="Bold"/>
                    <TextBox Name="txt_Remarks" Width="350"  Height="50" HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" VerticalScrollBarVisibility="Visible"/>
                    <TextBlock Padding="10,5,0,0">Are you sure you want to reject this order?</TextBlock>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3" Margin="0,0,0,0" HorizontalAlignment="Center">
                    <Button Content="Yes" Margin="0,0,88,0" Name="btnYes" Width="76" HorizontalAlignment="Right" Background="{DynamicResource NormalBackgroundBrush}" Foreground="{DynamicResource ResourceKey=NormalForegroundBrush}" Style="{DynamicResource styGlassButton}" IsDefault="True" Height="23" VerticalAlignment="Top" Click="btnYes_Click"  />
                    <Button Content="No" Name="btnNo" HorizontalAlignment="Right" Margin="0,0,6,0"  Width="76" Height="23" VerticalAlignment="Top"  Background="{DynamicResource NormalBackgroundBrush}" Foreground="{DynamicResource ResourceKey=NormalForegroundBrush}" Style="{DynamicResource styGlassButton}" Click="btnNo_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
