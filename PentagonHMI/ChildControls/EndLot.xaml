<Window x:Class="PentamasterHMI.ChildControls.EndLot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EndLot" Height="130" Width="350">
    <Border CornerRadius=" 12,12,12,12" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}"  Grid.Row="0" Background="White">
        <Grid>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
              
            </Grid.RowDefinitions>
            <Label x:Name="lblTitle"  Content="End Lot" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Padding="30,2,2,0" Grid.ColumnSpan="2" />

            <Grid Grid.Row="2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />



                </Grid.ColumnDefinitions>
                <!--<Button Name="btnSave" Content="{DynamicResource MAIN_WINDOW_BUTTON_SAVE}" Click="btnSave_Click"  Width="75" Height="23" Background="{DynamicResource NormalButtonBrush}" Style="{DynamicResource styGlassButton}"  HorizontalAlignment="Right" Margin="0,0,10,5" VerticalAlignment="Bottom"/>-->
              
                    <Button Content="YES" Margin="0,0,0,0" Name="btnConfirm" Height="40" Width="76" VerticalAlignment="Center"  HorizontalAlignment="center" Background="{DynamicResource NormalBackgroundBrush}" Foreground="{DynamicResource ResourceKey=NormalForegroundBrush}" Style="{DynamicResource styGlassButton}"  />

                    <Button Grid.Column="1" Margin="0,0,10,0" Name="btnCancel" Width="76" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center" Content="NO" Background="{DynamicResource NormalBackgroundBrush}" Foreground="{DynamicResource ResourceKey=NormalForegroundBrush}" Style="{DynamicResource styGlassButton}"/>
             
            </Grid>
        </Grid>
    </Border>
</Window>
