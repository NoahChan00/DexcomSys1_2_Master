<UserControl x:Class="PentagonHMI.ChildControls.ucLotEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uc="clr-namespace:PentagonHMI.UserControls" 
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="1035"
             xmlns:my="clr-namespace:PentagonHMI.UserControls">
    <UserControl.Resources>
        <Style
            
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_DATETIME_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter 
                
                Property="Content"
                Value="No." />

            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_USER_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter 
                Property="Content"
                Value="Lot ID" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_LOG_TYPE_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter
                Property="Content"
                Value="Quantity" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_DESCRIPTION_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter 
                Property="Content"
                Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_DESCRIPTION}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <!--<RowDefinition Height="30" />-->
            </Grid.RowDefinitions>
            <Label Grid.Row="0" x:Name="lblTitle" Content="LOT Entry" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="30,2,2,0" />
            <!--<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">-->
            <Grid Grid.Row="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
           
               

                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="*" />
                        <!--<RowDefinition Height="30" />-->
                    </Grid.RowDefinitions>
                    <Border   CornerRadius="16,16,16,16"  BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" Margin="0,0,5,0" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Content="Lot Number"  Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0,0,5,0" Padding="30,2,2,0" />

                        <Grid Grid.Row="1">


                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="50" />

                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />



                            </Grid.ColumnDefinitions>
                            <Label Content="Lot Number"   FontSize="18" Grid.Row="0" Grid.Column="0" Margin="10"/>
                            <TextBox Height="30" Name="txtLotNumber" Width="300"  FontSize="14" Grid.Row="0" Grid.Column="1"   />

                            <Button Background="{DynamicResource NormalBackgroundBrush}" Content="Start Lot" Foreground="{DynamicResource NormalForegroundBrush}" Height="30" Name="btnNewLot" Style="{DynamicResource styGlassButton}" Width="100" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Click="btnNewLot_Click" FontSize="14" Margin="0,0,30,0"   />


                        </Grid>


                    </Grid>

                    <Border Grid.Row="1"  CornerRadius="16,16,16,16"  BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" Margin="0,5,5,0" />
                    <Grid Grid.Row="1" Margin="0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Content="List Of Lot Number"  Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0,0,5,0" Padding="30,2,2,0" />

                        <Grid Grid.Row="1">

                            <ScrollViewer
            VerticalScrollBarVisibility="Hidden"
            Height="auto"
            Margin="15">
                                <DataGrid
                Name="dgLog" 
                                    FontSize="16"
                AutoGenerateColumns="False"
                ItemsSource="{Binding}"
                MaxHeight="320"
                IsReadOnly="False"
                SelectionChanged="dgLog_SelectionChanged"
                Margin="0, 0, 0, 0"  MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource  Mode=FindAncestor, AncestorType=Grid}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                        Binding="{Binding LogNo}"
                        HeaderStyle="{StaticResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_DATETIME_STYLE}"
                        SortDirection="Descending"/>
                                        <DataGridTextColumn
                        Binding="{Binding LogLotNumber}"
                        Header="Lot Number"  />
                          
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>





                        </Grid>


                    </Grid>
                </Grid>

                  
                
                
   

           


                <Border Grid.Column="1"  CornerRadius="16,16,16,16"  BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" Margin="0,0,5,0" />

                <Grid Grid.Column="1" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Lot Summary"  Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0,0,5,0" Padding="30,2,2,0" />

                    <Grid Grid.Row="1">

                        <StackPanel>
                           
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="ucLotNumber" VerticalAlignment="Top" ucLabelTitleContent="LOT Number"  ucLabelTitleWidth="225"  Margin="5,5,0,0" ucText="" FontSize="16"  />
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="ucStartDateTime" VerticalAlignment="Top" ucLabelTitleContent="{DynamicResource OEE_INFO_LABEL_START_DATE_TIME}"  ucLabelTitleWidth="225"  Margin="5,5,0,0" ucText="" FontSize="16"  />
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="ucEndDateTime" VerticalAlignment="Top" ucLabelTitleContent="End Date Time"  ucLabelTitleWidth="225"  Margin="5,5,0,0" ucText="" FontSize="16"  />
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="ucTotalPass" VerticalAlignment="Top" ucLabelTitleContent="{DynamicResource OEE_INFO_LABEL_TOTAL_PASS}"  ucLabelTitleWidth="225" Margin="5,5,0,0"  ucText="" FontSize="16"/>
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="ucTotalFail" VerticalAlignment="Top" ucLabelTitleContent="{DynamicResource OEE_INFO_LABEL_TOTAL_FAIL}" ucLabelTitleWidth="225"  Margin="5,5,0,0"  ucText="" FontSize="16"/>
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="ucTotalCount" VerticalAlignment="Top" ucLabelTitleContent="Total Count" ucLabelTitleWidth="225"  Margin="5,5,0,0"  ucText="" FontSize="16"/>
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="ucDowntime" VerticalAlignment="Top" ucLabelTitleContent="Downtime" ucLabelTitleWidth="225"  Margin="5,5,0,0"  ucText="" FontSize="16"/>
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="ucIdleTime" VerticalAlignment="Top" ucLabelTitleContent="Idle Time" ucLabelTitleWidth="225"  Margin="5,5,0,0"  ucText="" FontSize="16"/>
                            <my:UCLabelTitleLabelDisplay1 HorizontalAlignment="Left"  x:Name="ucOperation" VerticalAlignment="Top" ucLabelTitleContent="Operation Time" ucLabelTitleWidth="225"  Margin="5,5,0,0"  ucText="" FontSize="16"/>

                        </StackPanel>





                    </Grid>
                    
                  

                </Grid>

             





            </Grid>
            
            
           
         


           
        </Grid>
    </ScrollViewer>
</UserControl>


