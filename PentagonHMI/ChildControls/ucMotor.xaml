<UserControl x:Class="PentagonHMI.ChildControls.ucMotor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uc="clr-namespace:PentagonHMI.UserControls" 
             mc:Ignorable="d"
             xmlns:my="clr-namespace:PentagonHMI.UserControls">
    <UserControl.Resources>
        <Style TargetType="ToggleButton">
            <EventSetter Event="Click" Handler="EM_MouseClick"/>
            <Setter Property="DockPanel.Dock" Value="Top"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Label Margin="0" Background="Red" Content="Engineering Mode (OFF)" FontSize="18" FontWeight="Bold" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Width="300"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <Label Margin="0" Background="LimeGreen" Content="Engineering Mode (ON)" FontSize="18" FontWeight="Bold" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Width="300"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="16,16,16,16"  BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" Margin="0,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" x:Name="lblTitle" Content="Motor" Style="{DynamicResource styTopPenalBlue}" Height="30" VerticalAlignment="Top" FontSize="18" Margin="0" Padding="30,2,2,0" />
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TabControl MaxWidth="1720" FontSize="18" Name="MotorTab" Visibility="Visible">
                    <TabItem Name="EMTag" Header="EM" Background="White">
                        <ToggleButton HorizontalAlignment="Left" VerticalAlignment="Top" Name="tgEM"/>
                    </TabItem>
                </TabControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>