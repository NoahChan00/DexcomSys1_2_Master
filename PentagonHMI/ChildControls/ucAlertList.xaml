<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:my="clr-namespace:PentagonHMI.UserControls"
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" x:Class="PentagonHMI.ChildControls.ucAlertList"
             mc:Ignorable="d"   d:DesignHeight="641" d:DesignWidth="1035">
    <UserControl.Resources>
        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_DATETIME_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter
                Property="Content"
                Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_ALERT_CODE}" />
        </Style>
        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_STNID_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter
                Property="Content"
                Value="Station ID" />
        </Style>
        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_USER_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter
                Property="Content"
                Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_DESCRIPTION}" />
        </Style>

        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_MODULE_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter
                Property="Content"
                Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_MODULE}" />
        </Style>
        <Style
            x:Key="MAIN_WINDOW_DATATABLE_EVENT_HEADER_LOG_TYPE_STYLE"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter
                Property="Content"
                Value="{DynamicResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_ACTION}" />
        </Style>
        <SolidColorBrush x:Key="CheckBoxFillNormal" Color="#F4F4F4" />
        <SolidColorBrush x:Key="CheckBoxStroke" Color="#8E8F8F" />
        <Style x:Key="EmptyCheckBoxFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle StrokeDashArray="1 2" StrokeThickness="1" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" Margin="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckRadioFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle StrokeDashArray="1 2" StrokeThickness="40" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" Margin="14,0,0,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBoxStyle2" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Background" Value="{StaticResource CheckBoxFillNormal}" />
            <Setter Property="BorderBrush" Value="{StaticResource CheckBoxStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource EmptyCheckBoxFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <BulletDecorator Background="Transparent" SnapsToDevicePixels="true">
                            <BulletDecorator.Bullet>
                                <Themes:BulletChrome BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" IsChecked="{TemplateBinding IsChecked}" RenderMouseOver="{TemplateBinding IsMouseOver}" RenderPressed="{TemplateBinding IsPressed}" Margin="10,0,-37,-29" />
                            </BulletDecorator.Bullet>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Width="67" />
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="true">
                                <Setter Property="FocusVisualStyle" Value="{StaticResource CheckRadioFocusVisual}" />
                                <Setter Property="Padding" Value="4,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border   CornerRadius="16,16,16,16"  BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2" Margin="0,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="45" />
                <RowDefinition Height="180" />
            </Grid.RowDefinitions>
            <Grid>
                <Label
            Style="{DynamicResource styTopPenalBlue}"
            Content="Alarm List"
            FontSize="18"
            Height="30"
            Padding="30,2,2,0"
            Margin="0, 0, 0, 0"
            VerticalAlignment="Top" />
                <StackPanel Name="SP1" HorizontalAlignment="Right" Margin="0 0 15 0" Orientation="Horizontal">
                    <Label Content="Station: " FontWeight="Bold" Foreground="White"></Label>
                    <ComboBox SelectionChanged="Cb_Station_SelectionChanged" x:Name="Cb_Station" Height="30" VerticalAlignment="Top" MinWidth="100" FontWeight="Bold">
                        <ComboBoxItem IsSelected="True" Content="{DynamicResource STATION 0}"></ComboBoxItem>
                        <ComboBoxItem Content="{DynamicResource STATION 8}"></ComboBoxItem>
                        <ComboBoxItem Content="{DynamicResource STATION 9}"></ComboBoxItem>
                        <ComboBoxItem Content="{DynamicResource STATION 10}"></ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            Height="auto"
            FontSize="14"
            Margin="0, 30, 0, 0">
                    <DataGrid
                x:Name="dgLog"
                AutoGenerateColumns="False"
                ItemsSource="{Binding}"

                IsReadOnly="True"
                Margin="0, 0, 0, 0"  MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Grid}, Mode=FindAncestor}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                        Binding="{Binding AlmCode}"
                        HeaderStyle="{StaticResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_DATETIME_STYLE}"
                        SortDirection="Descending" />
                            <DataGridTextColumn
                        Binding="{Binding StationID}"
                        HeaderStyle="{StaticResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_STNID_STYLE}"
                        SortDirection="Descending" />
                            <DataGridTextColumn
                        Binding="{Binding ModuleCode}"
                        HeaderStyle="{StaticResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_MODULE_STYLE}" />
                            <DataGridTextColumn
                        Binding="{Binding AlmDesc}"
                        HeaderStyle="{StaticResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_USER_STYLE}" />
                            <DataGridTextColumn
                        Binding="{Binding AlmAction}"
                        HeaderStyle="{StaticResource MAIN_WINDOW_DATATABLE_EVENT_HEADER_LOG_TYPE_STYLE}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Grid>

            <GroupBox Grid.Row="2" Header="Alarm Config" FontSize="16" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}" Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel  Margin="10,0,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <Label Content="Alarm Code" Height="28"  FontSize="14" />
                                <TextBox Height="30" IsEnabled="False" x:Name="txtAlarmCode" Width="100"  Margin="130,-26,0,0"  TextChanged="txtAlarmCode_TextChanged" FontSize="14" IsReadOnly="True" />
                            </StackPanel>
                            <StackPanel>
                                <Label Content="Station ID" Height="28"  FontSize="14" />
                                <TextBox Height="30" x:Name="txtStd" IsEnabled="False" Width="100"  Margin="130,-26,0,0"  TextChanged="txtAlarmCode_TextChanged" FontSize="14" IsReadOnly="True" />
                            </StackPanel>
                        </StackPanel>
                        <Label Content="Module" Height="28"  FontSize="14" />
                        <TextBox Height="30" x:Name="txtModule" Width="600"  Margin="130,-26,0,0"  TextChanged="txtModule_LostFocus"  FontSize="14" />
                        <Label Content="Error Message" Height="28"  FontSize="14" />
                        <TextBox Height="30" x:Name="txtErrorMessage" Width="600"  Margin="130,-26,0,0" LostFocus="txtErrorMessage_LostFocus" FontSize="14" />
                        <Label Content="Action" Height="28"  FontSize="14" />
                        <TextBox Height="30" x:Name="txtAction" Width="600"  Margin="130,-26,0,0" LostFocus="txtAction_LostFocus" FontSize="14" />
                    </StackPanel>
                    <StackPanel  Grid.Column="1">
                        <Button Grid.Row="0" Grid.Column="1" Background="{DynamicResource NormalBackgroundBrush}" Content="Save" Foreground="{DynamicResource NormalForegroundBrush}" Height="30" x:Name="btnSave" Style="{DynamicResource styGlassButton}" Width="120" Margin="35,24,48,88" HorizontalAlignment="Center" VerticalAlignment="Center"  Click="btnSave_Click" FontSize="14" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>