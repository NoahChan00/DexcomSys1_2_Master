<UserControl x:Class="PentagonHMI.ChildControls.ucIOInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" xmlns:my="clr-namespace:PentagonHMI.UserControls">
    <UserControl.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        </Style>
        <Style TargetType="ToggleButton">
            <EventSetter Event="Click" Handler="EM_MouseClick"/>
            <Setter Property="DockPanel.Dock" Value="Top"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Margin" Value="10 2 10 2"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Label Background="Red" Content="Engineering Mode (OFF)" FontSize="18" FontWeight="Bold" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Width="300"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <Label Background="LimeGreen" Content="Engineering Mode (ON)" FontSize="18" FontWeight="Bold" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Width="300"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!--<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">-->
    <Border CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource GridLineBrush}" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="15" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Style="{DynamicResource styTopPenalBlue}" Content="Machine Input/Output List" FontSize="18" Height="30" Padding="30,2,2,0" />
            <TabControl Name="IOMajorTabControl" FontSize="20" Margin="0,12,5,5" BorderBrush="Gainsboro" SelectionChanged="SelectionChangedMethod"  VirtualizingPanel.IsVirtualizing="true" Grid.Row="1">
            </TabControl>
            <ToggleButton Name="T1" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>
    </Border>
    <!--</ScrollViewer>-->
</UserControl>